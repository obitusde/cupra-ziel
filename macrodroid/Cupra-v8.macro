 "childrenCollapsed": false, "dontLogIfConditionIsFalse": false, "m_comment": "Knopf erkannt"}, {"action": 0, "uiInteractionConfiguration": {"blocking": false, "checkOverlays": false, "clickOption": 1, "longClick": false, "showTouchLocation": false, "skipCount": "0", "textContent": "(?i).*fahrzeug senden.*", "textMatchOption": 0, "useRegex": true, "xyPercentages": false, "xyPoint": {"x": 0, "y": 0}, "type": "Click"}, "disableLogging": false, "m_SIGUID": 2475902406994375814, "m_classType": "UIInteractionAction", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "m_comment": "a) Text-Klick auf den Senden-Knopf (Gross-/Kleinschreibung egal)"}, {"disableLogging": false, "m_SIGUID": 3265953583417169009, "m_classType": "PauseAction", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "m_delayInMilliSeconds": 0, "m_delayInSeconds": 2, "m_useAlarm": true, "unitForVariables": 0}, {"disableLogging": false, "m_SIGUID": 4697217527877329819, "m_classType": "CheckTextOnScreenAction", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "booleanVariableName": "cupra_knopf", "enableRegex": false, "forceScreenRefresh": true, "ignoreCase": true, "ignoreHiddenText": true, "includeOverlays": false, "matchOption": 1, "textToCheck": "Fahrzeug senden", "m_comment": "Knopf noch da? (dann hat der Text-Klick nicht gewirkt)"}, {"disableLogging": false, "m_SIGUID": 8747986643944452590, "m_classType": "IfConditionAction", "m_constraintList": [{"disableLogging": false, "m_SIGUID": -8591032308815347541, "m_classType": "MacroDroidVariableConstraint", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "checkCase": false, "dictionaryKeys": {"keys": []}, "dictionaryType": 0, "enableRegex": false, "m_booleanValue": true, "m_doubleValue": 0.0, "m_intCompareVariable": false, "m_intGreaterThan": false, "m_intLessThan": false, "m_intNotEqual": false, "m_intValue": 0, "m_stringComparisonType": 0, "m_stringEqual": true, "m_variable": {"dictionary": {"entries": [], "isArray": false, "variableType": 4, "type": "Dictionary"}, "isActionBlockWorkingVar": false, "isLocalVar": false, "isSecure": false, "m_booleanValue": false, "m_decimalValue": 0.0, "m_intValue": 0, "m_name": "cupra_knopf", "m_stringValue": "", "m_type": 0, "supportsInput": true, "supportsOutput": true}}], "m_isDisabled": false, "m_isOrCondition": false, "childrenCollapsed": false, "dontLogIfConditionIsFalse": false, "m_comment": "b) Bildschirm lesen und auf die Mitte des Knopfs tippen"}, {"disableLogging": false, "m_SIGUID": -5503056379691800423, "m_classType": "ReadScreenContentsAction", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "dictionaryKeys": {"keys": []}, "forceScreenRefresh": true, "includeOverlays": false, "includeScreenLocation": true, "includeWithoutText": false, "isLocalVar": false, "variableName": "cupra_seite", "m_comment": "Bildschirm lesen -> Woerterbuch cupra_seite (Text + Position)"}, {"disableLogging": false, "m_SIGUID": -1651221373171025087, "m_classType": "ShellScriptAction", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "blockNextAction": true, "m_nonRoot": false, "timeoutSeconds": 15, "useHelper": false, "useShizuku": true, "m_script": "# Cupra v8: \"AN DAS FAHRZEUG SENDEN\" dort tippen, wo der Knopf gerade ist (Position aus \"Bildschirminhalt lesen\")\nX=\"\"; Y=\"\"; x=\"\"; y=\"\"\nwhile IFS= read -r z; do\n  case \"$z\" in\n    \"-- [centerX]: \"*) x=${z#*: } ;;\n    \"-- [centerY]: \"*) y=${z#*: } ;;\n    \"-- [text]: \"*) s=${z#*\\]: }\n      case \"$s\" in *[Ff][Aa][Hh][Rr][Zz][Ee][Uu][Gg]\" \"[Ss][Ee][Nn][Dd][Ee][Nn]*) X=${x%%.*}; Y=${y%%.*} ;; esac ;;\n  esac\ndone <<'ENDE_SEITE'\n{v=cupra_seite}\nENDE_SEITE\ncase \"$X$Y\" in \"\"|*[!0-9]*) X=540; Y=2260 ;; esac\ninput tap $X $Y </dev/null >/dev/null 2>&1\n", "m_comment": "Mitte des Senden-Knopfs suchen und per Shizuku tippen (sonst 540,2260)"}, {"disableLogging": false, "m_SIGUID": 845651886564872184, "m_classType": "PauseAction", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "m_delayInMilliSeconds": 0, "m_delayInSeconds": 2, "m_useAlarm": true, "unitForVariables": 0}, {"disableLogging": false, "m_SIGUID": -6386869004546752042, "m_classType": "CheckTextOnScreenAction", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "booleanVariableName": "cupra_knopf", "enableRegex": false, "forceScreenRefresh": true, "ignoreCase": true, "ignoreHiddenText": true, "includeOverlays": false, "matchOption": 1, "textToCheck": "Fahrzeug senden", "m_comment": "Knopf jetzt weg?"}, {"disableLogging": false, "m_SIGUID": 8412113465871041672, "m_classType": "EndIfAction", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false}, {"disableLogging": false, "m_SIGUID": 8138228467457984172, "m_classType": "IfConditionAction", "m_constraintList": [{"disableLogging": false, "m_SIGUID": -775127886174152371, "m_classType": "MacroDroidVariableConstraint", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "checkCase": false, "dictionaryKeys": {"keys": []}, "dictionaryType": 0, "enableRegex": false, "m_booleanValue": true, "m_doubleValue": 0.0, "m_intCompareVariable": false, "m_intGreaterThan": false, "m_intLessThan": false, "m_intNotEqual": false, "m_intValue": 0, "m_stringComparisonType": 0, "m_stringEqual": true, "m_variable": {"dictionary": {"entries": [], "isArray": false, "variableType": 4, "type": "Dictionary"}, "isActionBlockWorkingVar": false, "isLocalVar": false, "isSecure": false, "m_booleanValue": false, "m_decimalValue": 0.0, "m_intValue": 0, "m_name": "cupra_knopf", "m_stringValue": "", "m_type": 0, "supportsInput": true, "supportsOutput": true}}], "m_isDisabled": false, "m_isOrCondition": false, "childrenCollapsed": false, "dontLogIfConditionIsFalse": false, "m_comment": "Knopf immer noch da -> Christof tippt selbst"}, {"disableLogging": false, "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "cancelPrevious": true, "m_backgroundColor": -14606047, "m_displayIcon": false, "m_duration": 5, "m_horizontalPosition": 0, "m_imageName": "launcher_no_border", "m_imagePackageName": "com.arlosoft.macrodroid", "m_imageResourceName": "launcher_no_border", "m_messageText": "Nicht gesendet - bitte selbst AN DAS FAHRZEUG SENDEN tippen", "m_position": 0, "m_textColor": -1, "m_tintIcon": false, "maintainSpaces": false, "textAlignment": 0, "useTextOnly": true, "m_comment": "", "m_classType": "ToastAction", "m_SIGUID": 1581302508710423100}, {"disableLogging": false, "m_SIGUID": -7567903057128999105, "m_classType": "EndIfAction", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false}, {"disableLogging": false, "m_SIGUID": 120684857974753129, "m_classType": "IfConditionAction", "m_constraintList": [{"disableLogging": false, "m_SIGUID": -1405023923764292740, "m_classType": "MacroDroidVariableConstraint", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "checkCase": false, "dictionaryKeys": {"keys": []}, "dictionaryType": 0, "enableRegex": false, "m_booleanValue": false, "m_doubleValue": 0.0, "m_intCompareVariable": false, "m_intGreaterThan": false, "m_intLessThan": false, "m_intNotEqual": false, "m_intValue": 0, "m_stringComparisonType": 0, "m_stringEqual": true, "m_variable": {"dictionary": {"entries": [], "isArray": false, "variableType": 4, "type": "Dictionary"}, "isActionBlockWorkingVar": false, "isLocalVar": false, "isSecure": false, "m_booleanValue": false, "m_decimalValue": 0.0, "m_intValue": 0, "m_name": "cupra_knopf", "m_stringValue": "", "m_type": 0, "supportsInput": true, "supportsOutput": true}}], "m_isDisabled": false, "m_isOrCondition": false, "childrenCollapsed": false, "dontLogIfConditionIsFalse": false, "m_comment": "Knopf weg = gesendet"}, {"disableLogging": false, "m_SIGUID": 1259576272084464616, "m_classType": "PauseAction", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "m_delayInMilliSeconds": 0, "m_delayInSeconds": 2, "m_useAlarm": true, "unitForVariables": 0}, {"disableLogging": false, "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "m_classType": "LaunchHomeScreenAction", "m_SIGUID": 5378843262392768495}, {"disableLogging": false, "m_SIGUID": 2433360948075550365, "m_classType": "PauseAction", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "m_delayInMilliSeconds": 0, "m_delayInSeconds": 1, "m_useAlarm": true, "unitForVariables": 0}, {"disableLogging": false, "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "m_classType": "KillBackgroundAppAction", "m_applicationNameList": ["My CUPRA"], "m_packageNameList": ["com.cupra.mycupra"], "m_SIGUID": -5989009986330523014}, {"disableLogging": false, "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false, "cancelPrevious": true, "m_backgroundColor": -14606047, "m_displayIcon": false, "m_duration": 2, "m_horizontalPosition": 0, "m_imageName": "launcher_no_border", "m_imagePackageName": "com.arlosoft.macrodroid", "m_imageResourceName": "launcher_no_border", "m_messageText": "Ziel gesendet: {v=ziel}", "m_position": 0, "m_textColor": -1, "m_tintIcon": false, "maintainSpaces": false, "textAlignment": 0, "useTextOnly": true, "m_comment": "", "m_classType": "ToastAction", "m_SIGUID": -5279644167062625560}, {"disableLogging": false, "m_SIGUID": 8060753402355945024, "m_classType": "EndIfAction", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false}, {"disableLogging": false, "m_SIGUID": 6461108526447484694, "m_classType": "EndIfAction", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false}], "m_category": "Uncategorized", "m_completed": true, "m_constraintList": [], "m_description": "So laeuft es: Cupra-Ziel schickt ein Ziel -> myCupra oeffnet auf der Karte, Hinweis 'Parkposition' wird weggeklickt, Adresse wird ins Suchfeld eingefuegt, erster Treffer getippt. Dann wartet das Makro bis ca. 10 s, bis 'AN DAS FAHRZEUG SENDEN' zu sehen ist, und tippt den Knopf dort, wo er gerade ist (erst per Text, sonst Position lesen und per Shizuku tippen). Danach Startbildschirm, myCupra beenden, Meldung 'Ziel gesendet'. Du musst: Handy entsperrt und hochkant lassen; Shizuku muss laufen (wie beim Stempeln). Klappt das Senden nicht, bleibt myCupra offen mit der Meldung 'bitte selbst tippen'. Wird der Knopf gar nicht erkannt, tippt es wie v7 auf die feste Stelle. v8 (4.11.2026): Senden-Knopf per Text/Position statt fester Stelle, Wartezeit bis der Knopf da ist. v7 (26.10.2026): Senden-Knopf 540,2260. v6: Hinweis 'PARKPOSITION NICHT VERFUEGBAR' wegklicken. v5: Treffer 540,470.", "m_descriptionOpen": false, "m_enabled": true, "m_excludeLog": false, "m_headingColor": 0, "m_isOrCondition": false, "m_name": "Cupra v8", "m_triggerList": [{"identifier": "cupra", "ipAddressWhiteList": [], "variableWhiteList": [], "variableWhiteListEnabled": false, "disableLogging": false, "m_SIGUID": 6437297635136127682, "m_classType": "WebHookTrigger", "m_constraintList": [], "m_isDisabled": false, "m_isOrCondition": false}]}, "macroExportVersion": 1}