enden Knopf tippen: HO=113,436 (Entree/Sortie Home Office), SS=70,567 (Sur Site), HUB=172,567. Radius je Ort (5. Feld, Standard 800 m; Zuhause 300 m), sonst nichts tippen. Ergebnis als Benachrichtigung und in Download/stempeln.txt.","m_descriptionOpen":false,"m_enabled":true,"m_excludeLog":false,"m_headingColor":0,"m_isOrCondition":false,"m_name":"Stempeln Ort v2","m_triggerList":[{"disableLogging":false,"m_SIGUID":-8189535239796068483,"m_classType":"EmptyTrigger","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}]},"macroExportVersion":1}