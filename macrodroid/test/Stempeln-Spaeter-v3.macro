{"globalVariables":[{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"seite","m_stringValue":"","m_type":4,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":true,"m_decimalValue":0.0,"m_intValue":0,"m_name":"stempel_aktiv","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"frei_bis","m_stringValue":"","m_type":2,"supportsInput":true,"supportsOutput":true}],"macro":{"aiGenerated":0,"breakpoints":[],"disabledTimestamp":0,"exportedActionBlocks":[],"exportedSharedScenes":[],"forceEvenIfNotEnabledTimestamp":0,"isActionBlock":false,"isExtra":false,"isFavourite":false,"lastEditedTimestamp":1793087286224,"localVariables":[],"localVarsAlphabetical":true,"loggingLevel":0,"m_GUID":1999676986295743433,"m_actionList":[{"blockNextAction":true,"m_nonRoot":false,"m_script":"B=/sdcard/Download/stempeln\nmkdir -p $B\nDEBUG=1\nSOLL=505\nORTE=\"\"\nnote() { cmd notification post -S bigtext -t \"$2\" \"$3\" \"$1\" </dev/null >/dev/null 2>&1; }\njetzt() { if [ -n \"$T_JETZT\" ]; then set -- $T_JETZT; else set -- $(date '+%Y %m %d %H %M %u %s'); fi\n  JJ=$1; MM=${2#0}; TT=${3#0}; HH=${4#0}; MI=${5#0}; WT=$6; EPOCH=$7; HEUTE=$1-$2-$3; NOW=$(( ${HH:-0}*60 + ${MI:-0} )); }\nhm() { echo \"$(( $1 / 60 )):$(( $1 % 60 / 10 ))$(( $1 % 10 ))\"; }\nminuten() { h=${1%%:*}; m=${1#*:}; h=${h#0}; m=${m#0}; echo $(( ${h:-0}*60 + ${m:-0} )); }\nmikro() { g=${1%%.*}; f=${1#*.}; [ \"$f\" = \"$1\" ] && f=0; f=${f}000000; f=${f%\"${f#??????}\"}; echo $(( g*1000000 + 1$f - 1000000 )); }\nwurzel() { n=$1; x=$n; [ $x -le 1 ] && { echo $x; return; }; y=$(( (x+1)/2 )); while [ $y -lt $x ]; do x=$y; y=$(( (x + n/x)/2 )); done; echo $x; }\nabst() { a=$(( $1 - $3 )); b=$(( $2 - $4 )); [ $a -lt 0 ] && a=$(( -a )); [ $b -lt 0 ] && b=$(( -b ))\n  if [ $a -gt 200000 ] || [ $b -gt 200000 ]; then echo 99999; return; fi\n  a=$(( a*1112/10000 )); b=$(( b*766/10000 )); wurzel $(( a*a + b*b )); }\n# naechster Ort -> TYP DIST RAD NAME (TYP leer = kein gueltiger Standort)\nort() { TYP=\"\"; DIST=\"\"; RAD=\"\"; NAME=\"\"; ORTLISTE=\"\"\n  case \"$1$2\" in *[0-9].[0-9]*[0-9].[0-9]*) ;; *) return ;; esac\n  la=$(mikro \"$1\"); lo=$(mikro \"$2\")\n  set -f; alt=$IFS; IFS='|'\n  for o in $ORTE; do\n    IFS=';'; set -- $o; IFS='|'\n    [ $# -ge 4 ] || continue\n    e=$(abst $la $lo $(mikro \"$2\") $(mikro \"$3\")); r=${5:-800}\n    if [ \"$e\" = 99999 ]; then ORTLISTE=\"$ORTLISTE\n$4: ueber 20 km\"; else ORTLISTE=\"$ORTLISTE\n$4: $e m\"; fi\n    if [ -z \"$DIST\" ] || [ \"$e\" -lt \"$DIST\" ]; then TYP=$1; DIST=$e; RAD=$r; NAME=$4; fi\n  done\n  IFS=$alt; set +f; }\njetzt\necho $(( EPOCH + 900 )) > $B/spaeter.txt\nrm -f $B/vorschlag.txt\nnote \"Erinnerung in 15 min\" \"Stempeln\" stempeln\n","timeoutSeconds":15,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-349738316568515979,"m_classType":"ShellScriptAction","m_comment":"15 min Ruhe","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_category":"Uncategorized","m_completed":true,"m_constraintList":[],"m_description":"Stempeln Spaeter v3.0: Knopf \"Spaeter\" im Vorschlag - 15 min keine Vorschlaege.","m_descriptionOpen":false,"m_enabled":true,"m_excludeLog":false,"m_headingColor":0,"m_isOrCondition":false,"m_name":"Stempeln Spaeter v3","m_triggerList":[{"disableLogging":false,"m_SIGUID":-38232047211056151,"m_classType":"EmptyTrigger","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}]},"macroExportVersion":1}