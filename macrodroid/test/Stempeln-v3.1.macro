 RAD=$r; NAME=$4; fi\n  done\n  IFS=$alt; set +f; }\n# Wörterbuch aus \"Bildschirminhalt lesen\" -> Zeilen \"x|y|Text\"\nelemente() { x=\"\"; y=\"\"\n  while IFS= read -r z; do\n    case \"$z\" in\n      \"-- [centerX]: \"*) x=${z#*: } ;;\n      \"-- [centerY]: \"*) y=${z#*: } ;;\n      \"-- [text]: \"*) s=${z#*\\]: }; [ -n \"$s\" ] && echo \"$x|$y|$s\" ;;\n    esac\n  done < \"$1\"; }\n# Stand aus Elementliste $1: STATUS (IN/OUT/?), PRES (Minuten, leer = nicht gelesen), LETZTE, BUCH, Knopf-Positionen\nstand() { STATUS=\"?\"; HOT=\"\"; PRES=\"\"; HOX=113; HOY=436; SSX=70; SSY=567; HUX=172; HUY=567; ZEITEN=\"\"\n  while IFS='|' read -r x y s; do\n    case \"$x$y\" in *[!0-9]*|\"\") continue ;; esac\n    if [ \"$x\" -lt 600 ]; then\n      case \"$s\" in\n        *\" HOME OFFICE\") HOT=$s; HOX=$x; HOY=$y\n          case \"$s\" in SORTIE*) STATUS=IN ;; ENTR*) STATUS=OUT ;; esac ;;\n        \"SUR SITE\") SSX=$x; SSY=$y ;;\n        HUB) HUX=$x; HUY=$y ;;\n        *\"Temps de pr\"*) p=${s%%[!0-9:]*}; case \"$p\" in *[0-9]:[0-9][0-9]) PRES=$(minuten \"$p\") ;; esac ;;\n      esac\n    elif [ \"$x\" -gt 720 ]; then\n      case \"$s\" in [0-2][0-9]:[0-5][0-9]) ZEITEN=\"$ZEITEN $s\" ;; esac\n    fi\n  done < \"$1\"\n  LETZTE=\"\"; BUCH=0; PAUSE=0; aus=\"\"\n  # Zeiten abwechselnd rein/raus; Luecken nach einem Ausstempeln 11:00-14:30 = Mittagspause\n  for s in $(for s in $ZEITEN; do echo $s; done | sort -u); do\n    LETZTE=$s; BUCH=$(( BUCH + 1 )); m=$(minuten $s)\n    if [ $(( BUCH % 2 )) = 0 ]; then aus=$m\n    elif [ -n \"$aus\" ]; then [ $aus -ge 660 ] && [ $aus -le 870 ] && PAUSE=$(( PAUSE + m - aus )); aus=\"\"; fi\n  done; }\nD=$(cat $B/aktuell.txt 2>/dev/null); [ -d \"$D\" ] || { D=$B/ohne-start; mkdir -p \"$D\"; }\nL=$D/log.txt; exec 2>>\"$L\"\nt() { echo \"$(date +%T) $*\" >> \"$L\"; }\njetzt\ngrep -v 'ticket=' > \"$D/seite-vor.txt\" <<'ENDE_SEITE'\n{v=seite}\nENDE_SEITE\nelemente \"$D/seite-vor.txt\" > \"$D/elemente-vor.txt\"\nstand \"$D/elemente-vor.txt\"\nt \"Seite vorher: Status=$STATUS Knopf='$HOT' Praesenz=$PRES Letzte=$LETZTE Buchungen=$BUCH\"\nLAT=\"{last_loc_lat}\"; LON=\"{last_loc_long}\"\nort \"$LAT\" \"$LON\"\nt \"Standort $LAT,$LON -> $TYP $NAME $DIST m (Radius $RAD)\"\nWUNSCH=\"\"; [ -f $B/vorschlag.txt ] && . $B/vorschlag.txt && [ $(( EPOCH - ${V_ZEIT:-0} )) -lt 1800 ] && WUNSCH=$V_ZIEL\nrm -f $B/vorschlag.txt\nt \"Wunsch aus Vorschlag: '${WUNSCH:-keiner}'\"\n[ $DEBUG = 1 ] && screencap -p \"$D/1-vor-tipp.png\" </dev/null >/dev/null 2>&1\nAKTION=keine; KNOPF=\"\"\nif [ -z \"$PRES\" ] && [ \"$STATUS\" = \"?\" ]; then\n  ERGT=\"Stempelseite nicht gelesen - nichts gestempelt, bitte selbst pruefen\"\nelif [ \"$WUNSCH\" = EIN ] && [ \"$STATUS\" = IN ]; then\n  ERGT=\"Du bist schon eingestempelt - nichts getippt\"\nelif [ \"$WUNSCH\" = AUS ] && [ \"$STATUS\" = OUT ]; then\n  ERGT=\"Du bist schon ausgestempelt - nichts getippt\"\nelif [ -z \"$TYP\" ] || [ \"$DIST\" -gt \"$RAD\" ]; then\n  AKTION=manuell\n  if [ -z \"$TYP\" ]; then W=\"kein Standort\"; else W=\"naechster Ort $NAME, $DIST m\"; fi\n  ERGT=\"Unbekannter Ort ($W)\"\n  note \"Unbekannter Ort ($W) - tippe selbst auf der Seite den passenden Knopf. Ich lese in 60 s nach.\" \"Stempeln\" stempeln\n  t \"manuell: warte 60 s\"; sleep 60\nelse\n  case \"$TYP\" in\n    HO)  X=$HOX; Y=$HOY; KNOPF=\"Home Office\" ;;\n    SS)  X=$SSX; Y=$SSY; KNOPF=\"Sur Site\" ;;\n    HUB) X=$HUX; Y=$HUY; KNOPF=\"Hub\" ;;\n  esac\n  t \"Tippe $KNOPF bei $X,$Y ($NAME, $DIST m)\"\n  input tap $X $Y </dev/null >/dev/null 2>&1\n  t \"Tipp rc=$?\"\n  AKTION=tipp; ERGT=\"$KNOPF ($NAME)\"\n  [ $DEBUG = 1 ] && { sleep 2; screencap -p \"$D/2-nach-tipp.png\" </dev/null >/dev/null 2>&1; }\nfi\n{ echo \"A_AKTION=$AKTION\"; echo \"A_STATUS=$STATUS\"; echo \"A_TYP=$TYP\"; echo \"A_KNOPF='$KNOPF'\"; echo \"A_TEXT='$ERGT'\"; } > \"$D/aktion.txt\"\nt \"Aktion: $AKTION - $ERGT\"\n","timeoutSeconds":100,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":966491130013496593,"m_classType":"ShellScriptAction","m_comment":"Stand lesen, Ort bestimmen, passenden Knopf tippen; kein Doppel-Stempeln; unbekannter Ort: 60 s selbst tippen","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":4523529672757992579,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln v3.1 | 3 neu laden","m_comment":""},{"m_delayInMilliSeconds":0,"m_delayInSeconds":3,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":3353442414522778731,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"EXTRA_TYPE_AUTO":0,"EXTRA_TYPE_BOOLEAN":2,"EXTRA_TYPE_DOUBLE":6,"EXTRA_TYPE_FLOAT":5,"EXTRA_TYPE_INT":3,"EXTRA_TYPE_LONG":4,"EXTRA_TYPE_STRING":1,"EXTRA_TYPE_STRING_ARRAY":7,"EXTRA_TYPE_URI":8,"additionalExtras":[],"m_action":"android.intent.action.VIEW","m_className":"","m_data":"https://aptime.cloud-horoquartz.fr/webquartz/ux/clock","m_extra1Name":"com.android.browser.application_id","m_extra1Type":1,"m_extra1Value":"macrodroid.stempeln","m_extra2Name":"","m_extra2Type":0,"m_extra2Value":"","m_extra3Name":"","m_extra3Type":0,"m_extra3Value":"","m_extra4Name":"","m_extra4Type":0,"m_extra4Value":"","m_extra5Name":"","m_extra5Type":0,"m_extra5Value":"","m_extra6Name":"","m_extra6Type":0,"m_extra6Value":"","m_flags":0,"m_mimeType":"","m_packageName":"com.android.chrome","m_target":"Activity","useCustomCategory":false,"disableLogging":false,"m_SIGUID":-7819011236183593325,"m_classType":"SendIntentAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Stempelseite in Chrome; application_id -> Chrome nimmt jedes Mal denselben Tab"},{"m_delayInMilliSeconds":0,"m_delayInSeconds":6,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":8963376550227399979,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"dictionaryKeys":{"keys":[]},"forceScreenRefresh":true,"includeOverlays":false,"includeScreenLocation":true,"includeWithoutText":false,"isLocalVar":false,"variableName":"seite","disableLogging":false,"m_SIGUID":7339837478791007908,"m_classType":"ReadScreenContentsAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Stempelseite lesen -> Woerterbuch seite (Text + Position)"},{"blockNextAction":true,"m_nonRoot":false,"m_script":"B=/sdcard/Download/stempeln\nmkdir -p $B\nDEBUG=0\nSOLL=505\nORTE=\"\"\nnote() { cmd notification post -S bigtext -t \"$2\" \"$3\" \"$1\" </dev/null >/dev/null 2>&1; }\njetzt() { if [ -n \"$T_JETZT\" ]; then set -- $T_JETZT; else set -- $(date '+%Y %m %d %H %M %u %s'); fi\n  JJ=$1; MM=${2#0}; TT=${3#0}; HH=${4#0}; MI=${5#0}; WT=$6; EPOCH=$7; HEUTE=$1-$2-$3; NOW=$(( ${HH:-0}*60 + ${MI:-0} )); }\nhm() { echo \"$(( $1 / 60 )):$(( $1 % 60 / 10 ))$(( $1 % 10 ))\"; }\nminuten() { h=${1%%:*}; m=${1#*:}; h=${h#0}; m=${m#0}; echo $(( ${h:-0}*60 + ${m:-0} )); }\nmikro() { g=${1%%.*}; f=${1#*.}; [ \"$f\" = \"$1\" ] && f=0; f=${f}000000; f=${f%\"${f#??????}\"}; echo $(( g*1000000 + 1$f - 1000000 )); }\nwurzel() { n=$1; x=$n; [ $x -le 1 ] && { echo $x; return; }; y=$(( (x+1)/2 )); while [ $y -lt $x ]; do x=$y; y=$(( (x + n/x)/2 )); done; echo $x; }\nabst() { a=$(( $1 - $3 )); b=$(( $2 - $4 )); [ $a -lt 0 ] && a=$(( -a )); [ $b -lt 0 ] && b=$(( -b ))\n  if [ $a -gt 200000 ] || [ $b -gt 200000 ]; then echo 99999; return; fi\n  a=$(( a*1112/10000 )); b=$(( b*766/10000 )); wurzel $(( a*a + b*b )); }\n# naechster Ort -> TYP DIST RAD NAME (TYP leer = kein gueltiger Standort)\nort() { TYP=\"\"; DIST=\"\"; RAD=\"\"; NAME=\"\"; ORTLISTE=\"\"\n  case \"$1$2\" in *[0-9].[0-9]*[0-9].[0-9]*) ;; *) return ;; esac\n  la=$(mikro \"$1\"); lo=$(mikro \"$2\")\n  set -f; alt=$IFS; IFS='|'\n  for o in $ORTE; do\n    IFS=';'; set -- $o; IFS='|'\n    [ $# -ge 4 ] || continue\n    e=$(abst $la $lo $(mikro \"$2\") $(mikro \"$3\")); r=${5:-800}\n    if [ \"$e\" = 99999 ]; then ORTLISTE=\"$ORTLISTE\n$4: ueber 20 km\"; else ORTLISTE=\"$ORTLISTE\n$4: $e m\"; fi\n    if [ -z \"$DIST\" ] || [ \"$e\" -lt \"$DIST\" ]; then TYP=$1; DIST=$e; RAD=$r; NAME=$4; fi\n  done\n  IFS=$alt; set +f; }\n# Wörterbuch aus \"Bildschirminhalt lesen\" -> Zeilen \"x|y|Text\"\nelemente() { x=\"\"; y=\"\"\n  while IFS= read -r z; do\n    case \"$z\" in\n      \"-- [centerX]: \"*) x=${z#*: } ;;\n      \"-- [centerY]: \"*) y=${z#*: } ;;\n      \"-- [text]: \"*) s=${z#*\\]: }; [ -n \"$s\" ] && echo \"$x|$y|$s\" ;;\n    esac\n  done < \"$1\"; }\n# Stand aus Elementliste $1: STATUS (IN/OUT/?), PRES (Minuten, leer = nicht gelesen), LETZTE, BUCH, Knopf-Positionen\nstand() { STATUS=\"?\"; HOT=\"\"; PRES=\"\"; HOX=113; HOY=436; SSX=70; SSY=567; HUX=172; HUY=567; ZEITEN=\"\"\n  while IFS='|' read -r x y s; do\n    case \"$x$y\" in *[!0-9]*|\"\") continue ;; esac\n    if [ \"$x\" -lt 600 ]; then\n      case \"$s\" in\n        *\" HOME OFFICE\") HOT=$s; HOX=$x; HOY=$y\n          case \"$s\" in SORTIE*) STATUS=IN ;; ENTR*) STATUS=OUT ;; esac ;;\n        \"SUR SITE\") SSX=$x; SSY=$y ;;\n        HUB) HUX=$x; HUY=$y ;;\n        *\"Temps de pr\"*) p=${s%%[!0-9:]*}; case \"$p\" in *[0-9]:[0-9][0-9]) PRES=$(minuten \"$p\") ;; esac ;;\n      esac\n    elif [ \"$x\" -gt 720 ]; then\n      case \"$s\" in [0-2][0-9]:[0-5][0-9]) ZEITEN=\"$ZEITEN $s\" ;; esac\n    fi\n  done < \"$1\"\n  LETZTE=\"\"; BUCH=0; PAUSE=0; aus=\"\"\n  # Zeiten abwechselnd rein/raus; Luecken nach einem Ausstempeln 11:00-14:30 = Mittagspause\n  for s in $(for s in $ZEITEN; do echo $s; done | sort -u); do\n    LETZTE=$s; BUCH=$(( BUCH + 1 )); m=$(minuten $s)\n    if [ $(( BUCH % 2 )) = 0 ]; then aus=$m\n    elif [ -n \"$aus\" ]; then [ $aus -ge 660 ] && [ $aus -le 870 ] && PAUSE=$(( PAUSE + m - aus )); aus=\"\"; fi\n  done; }\nD=$(cat $B/aktuell.txt 2>/dev/null); [ -d \"$D\" ] || { D=$B/ohne-start; mkdir -p \"$D\"; }\nL=$D/log.txt; exec 2>>\"$L\"\nt() { echo \"$(date +%T) $*\" >> \"$L\"; }\ngrep -v 'ticket=' > \"$D/pruef.txt\" <<'ENDE_SEITE'\n{v=seite}\nENDE_SEITE\nelemente \"$D/pruef.txt\" > \"$D/pruef-el.txt\"\nstand \"$D/pruef-el.txt\"\nif [ -z \"$PRES\" ] && [ \"$STATUS\" = \"?\" ]; then\n  t \"Pruefung: Stempelseite nicht erkannt (Accueil?) - nochmal oeffnen\"\n  am start -a android.intent.action.VIEW -d \"https://aptime.cloud-horoquartz.fr/webquartz/ux/clock\" -p com.android.chrome --es com.android.browser.application_id macrodroid.stempeln </dev/null >/dev/null 2>&1\n  t \"am start rc=$?\"\n  sleep 7\nelse\n  t \"Pruefung: Stempelseite ok (Status=$STATUS, Praesenz=$PRES)\"\nfi\n","timeoutSeconds":25,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-3356222783646127234,"m_classType":"ShellScriptAction","m_comment":"Ist es die Stempelseite? Sonst (Accueil) nochmal oeffnen und 7 s warten","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"dictionaryKeys":{"keys":[]},"forceScreenRefresh":true,"includeOverlays":false,"includeScreenLocation":true,"includeWithoutText":false,"isLocalVar":false,"variableName":"seite","disableLogging":false,"m_SIGUID":6860009028158011615,"m_classType":"ReadScreenContentsAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Stempelseite lesen -> Woerterbuch seite (Text + Position)"},{"blockNextAction":true,"m_nonRoot":false,"m_script":"B=/sdcard/Download/stempeln\nmkdir -p $B\nDEBUG=0\nSOLL=505\nORTE=\"\"\nnote() { cmd notification post -S bigtext -t \"$2\" \"$3\" \"$1\" </dev/null >/dev/null 2>&1; }\njetzt() { if [ -n \"$T_JETZT\" ]; then set -- $T_JETZT; else set -- $(date '+%Y %m %d %H %M %u %s'); fi\n  JJ=$1; MM=${2#0}; TT=${3#0}; HH=${4#0}; MI=${5#0}; WT=$6; EPOCH=$7; HEUTE=$1-$2-$3; NOW=$(( ${HH:-0}*60 + ${MI:-0} )); }\nhm() { echo \"$(( $1 / 60 )):$(( $1 % 60 / 10 ))$(( $1 % 10 ))\"; }\nminuten() { h=${1%%:*}; m=${1#*:}; h=${h#0}; m=${m#0}; echo $(( ${h:-0}*60 + ${m:-0} )); }\nmikro() { g=${1%%.*}; f=${1#*.}; [ \"$f\" = \"$1\" ] && f=0; f=${f}000000; f=${f%\"${f#??????}\"}; echo $(( g*1000000 + 1$f - 1000000 )); }\nwurzel() { n=$1; x=$n; [ $x -le 1 ] && { echo $x; return; }; y=$(( (x+1)/2 )); while [ $y -lt $x ]; do x=$y; y=$(( (x + n/x)/2 )); done; echo $x; }\nabst() { a=$(( $1 - $3 )); b=$(( $2 - $4 )); [ $a -lt 0 ] && a=$(( -a )); [ $b -lt 0 ] && b=$(( -b ))\n  if [ $a -gt 200000 ] || [ $b -gt 200000 ]; then echo 99999; return; fi\n  a=$(( a*1112/10000 )); b=$(( b*766/10000 )); wurzel $(( a*a + b*b )); }\n# naechster Ort -> TYP DIST RAD NAME (TYP leer = kein gueltiger Standort)\nort() { TYP=\"\"; DIST=\"\"; RAD=\"\"; NAME=\"\"; ORTLISTE=\"\"\n  case \"$1$2\" in *[0-9].[0-9]*[0-9].[0-9]*) ;; *) return ;; esac\n  la=$(mikro \"$1\"); lo=$(mikro \"$2\")\n  set -f; alt=$IFS; IFS='|'\n  for o in $ORTE; do\n    IFS=';'; set -- $o; IFS='|'\n    [ $# -ge 4 ] || continue\n    e=$(abst $la $lo $(mikro \"$2\") $(mikro \"$3\")); r=${5:-800}\n    if [ \"$e\" = 99999 ]; then ORTLISTE=\"$ORTLISTE\n$4: ueber 20 km\"; else ORTLISTE=\"$ORTLISTE\n$4: $e m\"; fi\n    if [ -z \"$DIST\" ] || [ \"$e\" -lt \"$DIST\" ]; then TYP=$1; DIST=$e; RAD=$r; NAME=$4; fi\n  done\n  IFS=$alt; set +f; }\n# Wörterbuch aus \"Bildschirminhalt lesen\" -> Zeilen \"x|y|Text\"\nelemente() { x=\"\"; y=\"\"\n  while IFS= read -r z; do\n    case \"$z\" in\n      \"-- [centerX]: \"*) x=${z#*: } ;;\n      \"-- [centerY]: \"*) y=${z#*: } ;;\n      \"-- [text]: \"*) s=${z#*\\]: }; [ -n \"$s\" ] && echo \"$x|$y|$s\" ;;\n    esac\n  done < \"$1\"; }\n# Stand aus Elementliste $1: STATUS (IN/OUT/?), PRES (Minuten, leer = nicht gelesen), LETZTE, BUCH, Knopf-Positionen\nstand() { STATUS=\"?\"; HOT=\"\"; PRES=\"\"; HOX=113; HOY=436; SSX=70; SSY=567; HUX=172; HUY=567; ZEITEN=\"\"\n  while IFS='|' read -r x y s; do\n    case \"$x$y\" in *[!0-9]*|\"\") continue ;; esac\n    if [ \"$x\" -lt 600 ]; then\n      case \"$s\" in\n        *\" HOME OFFICE\") HOT=$s; HOX=$x; HOY=$y\n          case \"$s\" in SORTIE*) STATUS=IN ;; ENTR*) STATUS=OUT ;; esac ;;\n        \"SUR SITE\") SSX=$x; SSY=$y ;;\n        HUB) HUX=$x; HUY=$y ;;\n        *\"Temps de pr\"*) p=${s%%[!0-9:]*}; case \"$p\" in *[0-9]:[0-9][0-9]) PRES=$(minuten \"$p\") ;; esac ;;\n      esac\n    elif [ \"$x\" -gt 720 ]; then\n      case \"$s\" in [0-2][0-9]:[0-5][0-9]) ZEITEN=\"$ZEITEN $s\" ;; esac\n    fi\n  done < \"$1\"\n  LETZTE=\"\"; BUCH=0; PAUSE=0; aus=\"\"\n  # Zeiten abwechselnd rein/raus; Luecken nach einem Ausstempeln 11:00-14:30 = Mittagspause\n  for s in $(for s in $ZEITEN; do echo $s; done | sort -u); do\n    LETZTE=$s; BUCH=$(( BUCH + 1 )); m=$(minuten $s)\n    if [ $(( BUCH % 2 )) = 0 ]; then aus=$m\n    elif [ -n \"$aus\" ]; then [ $aus -ge 660 ] && [ $aus -le 870 ] && PAUSE=$(( PAUSE + m - aus )); aus=\"\"; fi\n  done; }\nD=$(cat $B/aktuell.txt 2>/dev/null); [ -d \"$D\" ] || { D=$B/ohne-start; mkdir -p \"$D\"; }\nL=$D/log.txt; exec 2>>\"$L\"\nt() { echo \"$(date +%T) $*\" >> \"$L\"; }\njetzt\ngrep -v 'ticket=' > \"$D/seite-nach.txt\" <<'ENDE_SEITE'\n{v=seite}\nENDE_SEITE\nelemente \"$D/seite-nach.txt\" > \"$D/elemente-nach.txt\"\nstand \"$D/elemente-nach.txt\"\nt \"Seite nachher: Status=$STATUS Knopf='$HOT' Praesenz=$PRES Letzte=$LETZTE Buchungen=$BUCH\"\n[ $DEBUG = 1 ] && screencap -p \"$D/3-nach-neuladen.png\" </dev/null >/dev/null 2>&1\nt \"Pause heute: $PAUSE min\"\nA_AKTION=keine; A_STATUS=\"?\"; A_TYP=\"\"; A_KNOPF=\"\"; A_TEXT=\"\"\n[ -f \"$D/aktion.txt\" ] && . \"$D/aktion.txt\"\nif [ -n \"$PRES\" ] && [ \"$STATUS\" != \"?\" ]; then\n  case \"$A_AKTION\" in tipp) ZORT=$A_TYP ;; manuell) ZORT=\"\" ;; *) ZORT=$( [ -f $B/zustand.txt ] && . $B/zustand.txt && [ \"$Z_DATUM\" = \"$HEUTE\" ] && echo $Z_ORT )\n      if [ -z \"$ZORT\" ] && [ \"$STATUS\" = IN ]; then ort \"{last_loc_lat}\" \"{last_loc_long}\"; [ -n \"$TYP\" ] && [ \"$DIST\" -le \"$RAD\" ] && ZORT=$TYP; fi ;;\n  esac\n  { echo \"Z_DATUM=$HEUTE\"; echo \"Z_STATUS=$STATUS\"; echo \"Z_PRES=$PRES\"; echo \"Z_LESE=$EPOCH\"; echo \"Z_LETZTE=$LETZTE\"; echo \"Z_BUCH=$BUCH\"; echo \"Z_ORT=$ZORT\"; } > $B/zustand.txt\n  REST=$(( SOLL - PRES ))\n  if [ \"$STATUS\" = IN ]; then\n    PZU=0; [ $PAUSE = 0 ] && [ $NOW -lt 870 ] && PZU=45\n    if [ $REST -gt 0 ]; then INFO=\"heute $(hm $PRES) - noch $(hm $REST) -> fertig um $(hm $(( (NOW + REST + PZU) % 1440 )))\"\n      [ $PZU -gt 0 ] && INFO=\"$INFO (mit 45 min Pause)\"\n    else INFO=\"heute $(hm $PRES) - 8 h 25 schon voll\"; fi\n    KOPF=\"Eingestempelt${LETZTE:+ $LETZTE}\"\n  else\n    if [ $REST -gt 0 ]; then INFO=\"heute $(hm $PRES) - noch $(hm $REST) offen\"\n      L2=$(minuten \"${LETZTE:-0:00}\"); [ $L2 -ge 660 ] && [ $L2 -le 870 ] && INFO=\"$INFO - Pause-Erinnerung um $(hm $(( L2 + 35 )))\"\n    else INFO=\"heute $(hm $PRES) - Feierabend\"; fi\n    KOPF=\"Ausgestempelt${LETZTE:+ $LETZTE}\"\n  fi\n  if [ \"$A_AKTION\" = tipp ] && [ \"$STATUS\" = \"$A_STATUS\" ]; then\n    MELD=\"ACHTUNG: $A_TEXT getippt, aber der Stand hat sich nicht geaendert ($KOPF). Bitte pruefen!\"\n  elif [ \"$A_AKTION\" = tipp ]; then MELD=\"$KOPF - $A_TEXT\n$INFO\"\n  elif [ \"$A_AKTION\" = manuell ] && [ \"$STATUS\" != \"$A_STATUS\" ]; then MELD=\"$KOPF (von Hand)\n$INFO\"\n  elif [ -z \"$A_TEXT\" ]; then MELD=\"$KOPF\n$INFO\"\n  else MELD=\"$A_TEXT\nStand: $KOPF - $INFO\"; fi\nelse\n  MELD=\"Stempelseite nicht gelesen - bitte selbst pruefen\"\n  [ \"$A_AKTION\" = keine ] && [ -n \"$A_TEXT\" ] && MELD=$A_TEXT\nfi\nt \"Meldung: $MELD\"\nnote \"$MELD\" \"Stempeln\" stempeln\necho \"$(date '+%d.%m.%Y %H:%M') $(echo \"$MELD\" | tr '\\n' ' ') [${D##*/}]\" >> /sdcard/Download/stempeln.txt\nrm -f $B/lock.txt\nt \"Ende\"\n","timeoutSeconds":40,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-4949399787772087408,"m_classType":"ShellScriptAction","m_comment":"Neuen Stand lesen, pruefen ob gebucht, Endzeit 8 h 25 (+45 min Pause, solange keine), Zustand speichern, Benachrichtigung","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":1891310695611398410,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln v3.1 | 4 Ende","m_comment":""},{"disableLogging":false,"m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_classType":"LaunchHomeScreenAction","m_SIGUID":-994908647791732982}],"m_category":"Uncategorized","m_completed":true,"m_constraintList":[],"m_description":"Stempeln v3.1 (28.10.2026; Pixel 8, Shizuku): wie v3 (Stand von der Seite, Ort per Standort, Knopf von der Seite, kein Doppel-Stempeln, Buchung pruefen); neu: Seite nur einmal oeffnen (nochmal nur bei Accueil), Standort parallel, Chrome bleibt offen (Anmeldung bleibt), Endzeit mit 45 min Pause solange heute noch keine Mittagspause (Ausstempeln 11:00-14:30), Logging aus (DEBUG=0, letzter Lauf in Download/stempeln/lauf/).","m_descriptionOpen":false,"m_enabled":true,"m_excludeLog":false,"m_headingColor":0,"m_isOrCondition":false,"m_name":"Stempeln v3.1","m_triggerList":[{"disableLogging":false,"m_SIGUID":4162758408692325152,"m_classType":"EmptyTrigger","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}]},"macroExportVersion":1}