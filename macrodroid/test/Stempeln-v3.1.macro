{"globalVariables":[{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"seite","m_stringValue":"","m_type":4,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":true,"m_decimalValue":0.0,"m_intValue":0,"m_name":"stempel_aktiv","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"frei_bis","m_stringValue":"","m_type":2,"supportsInput":true,"supportsOutput":true}],"macro":{"aiGenerated":0,"breakpoints":[],"disabledTimestamp":0,"exportedActionBlocks":[],"exportedSharedScenes":[],"forceEvenIfNotEnabledTimestamp":0,"isActionBlock":false,"isExtra":false,"isFavourite":false,"lastEditedTimestamp":1793087286224,"localVariables":[],"localVarsAlphabetical":true,"loggingLevel":0,"m_GUID":5174006023095118311,"m_actionList":[{"disableLogging":false,"m_SIGUID":-7827510352584038436,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln v3.1 | 1 Start","m_comment":""},{"disableLogging":false,"m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"cancelPrevious":true,"m_backgroundColor":-14606047,"m_displayIcon":false,"m_duration":2,"m_horizontalPosition":0,"m_imageName":"launcher_no_border","m_imagePackageName":"com.arlosoft.macrodroid","m_imageResourceName":"launcher_no_border","m_messageText":"Stempeln …","m_position":0,"m_textColor":-1,"m_tintIcon":false,"maintainSpaces":false,"textAlignment":0,"useTextOnly":true,"m_comment":"","m_classType":"ToastAction","m_SIGUID":-6238356748285429537},{"blockNextAction":true,"m_nonRoot":false,"m_script":"B=/sdcard/Download/stempeln\nmkdir -p $B\nDEBUG=0\nSOLL=505\nORTE=\"\"\nnote() { cmd notification post -S bigtext -t \"$2\" \"$3\" \"$1\" </dev/null >/dev/null 2>&1; }\njetzt() { if [ -n \"$T_JETZT\" ]; then set -- $T_JETZT; else set -- $(date '+%Y %m %d %H %M %u %s'); fi\n  JJ=$1; MM=${2#0}; TT=${3#0}; HH=${4#0}; MI=${5#0}; WT=$6; EPOCH=$7; HEUTE=$1-$2-$3; NOW=$(( ${HH:-0}*60 + ${MI:-0} )); }\nhm() { echo \"$(( $1 / 60 )):$(( $1 % 60 / 10 ))$(( $1 % 10 ))\"; }\nminuten() { h=${1%%:*}; m=${1#*:}; h=${h#0}; m=${m#0}; echo $(( ${h:-0}*60 + ${m:-0} )); }\nmikro() { g=${1%%.*}; f=${1#*.}; [ \"$f\" = \"$1\" ] && f=0; f=${f}000000; f=${f%\"${f#??????}\"}; echo $(( g*1000000 + 1$f - 1000000 )); }\nwurzel() { n=$1; x=$n; [ $x -le 1 ] && { echo $x; return; }; y=$(( (x+1)/2 )); while [ $y -lt $x ]; do x=$y; y=$(( (x + n/x)/2 )); done; echo $x; }\nabst() { a=$(( $1 - $3 )); b=$(( $2 - $4 )); [ $a -lt 0 ] && a=$(( -a )); [ $b -lt 0 ] && b=$(( -b ))\n  if [ $a -gt 200000 ] || [ $b -gt 200000 ]; then echo 99999; return; fi\n  a=$(( a*1112/10000 )); b=$(( b*766/10000 )); wurzel $(( a*a + b*b )); }\n# naechster Ort -> TYP DIST RAD NAME (TYP leer = kein gueltiger Standort)\nort() { TYP=\"\"; DIST=\"\"; RAD=\"\"; NAME=\"\"; ORTLISTE=\"\"\n  case \"$1$2\" in *[0-9].[0-9]*[0-9].[0-9]*) ;; *) return ;; esac\n  la=$(mikro \"$1\"); lo=$(mikro \"$2\")\n  set -f; alt=$IFS; IFS='|'\n  for o in $ORTE; do\n    IFS=';'; set -- $o; IFS='|'\n    [ $# -ge 4 ] || continue\n    e=$(abst $la $lo $(mikro \"$2\") $(mikro \"$3\")); r=${5:-800}\n    if [ \"$e\" = 99999 ]; then ORTLISTE=\"$ORTLISTE\n$4: ueber 20 km\"; else ORTLISTE=\"$ORTLISTE\n$4: $e m\"; fi\n    if [ -z \"$DIST\" ] || [ \"$e\" -lt \"$DIST\" ]; then TYP=$1; DIST=$e; RAD=$r; NAME=$4; fi\n  done\n  IFS=$alt; set +f; }\njetzt\necho $EPOCH > $B/lock.txt\nif [ $DEBUG = 1 ]; then D=$B/$(date +%Y-%m-%d_%H%M%S); else D=$B/lauf; rm -rf \"$D\"; fi\nmkdir -p \"$D\"; echo \"$D\" > $B/aktuell.txt\nL=$D/log.txt\necho \"$(date +%T) Stempeln v3.1 - Start\" > \"$L\"\nexec 2>>\"$L\"\nt() { echo \"$(date +%T) $*\" >> \"$L\"; }\nt \"Shizuku ok: $(id 2>&1 | cut -c1-40)\"\ngesperrt() { dumpsys window </dev/null 2>&1 | grep -cE 'isKeyguardShowing=true|mShowingLockscreen=true|mDreamingLockscreen=true'; }\nn=0\nwhile [ \"$(gesperrt)\" != 0 ] && [ $n -lt 60 ]; do\n  [ $n = 0 ] && { note \"Bitte entsperren - dann wird gestempelt\" \"Stempeln\" stempeln; t \"gesperrt, warte\"; }\n  sleep 2; n=$(( n + 2 ))\ndone\nt \"Sperre: $(dumpsys window </dev/null 2>&1 | grep -oE 'isKeyguardShowing=[a-z]*|mShowingLockscreen=[a-z]*|mDreamingLockscreen=[a-z]*' | sort -u | tr '\\n' ' ') (gewartet $n s)\"\nnote \"Stempeln laeuft ...\" \"Stempeln\" stempeln\n","timeoutSeconds":75,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-6826601007078426055,"m_classType":"ShellScriptAction","m_comment":"Shizuku-Check, wartet bis 60 s aufs Entsperren","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":-2367076562208873346,"m_classType":"ForceLocationUpdateAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Aktuellen Standort holen -> {last_loc_lat}/{last_loc_long}"},{"disableLogging":false,"m_SIGUID":7295935558535578989,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln v3.1 | 2 Seite oeffnen","m_comment":""},{"EXTRA_TYPE_AUTO":0,"EXTRA_TYPE_BOOLEAN":2,"EXTRA_TYPE_DOUBLE":6,"EXTRA_TYPE_FLOAT":5,"EXTRA_TYPE_INT":3,"EXTRA_TYPE_LONG":4,"EXTRA_TYPE_STRING":1,"EXTRA_TYPE_STRING_ARRAY":7,"EXTRA_TYPE_URI":8,"additionalExtras":[],"m_action":"android.intent.action.VIEW","m_className":"","m_data":"https://aptime.cloud-horoquartz.fr/webquartz/ux/clock","m_extra1Name":"com.android.browser.application_id","m_extra1Type":1,"m_extra1Value":"macrodroid.stempeln","m_extra2Name":"","m_extra2Type":0,"m_extra2Value":"","m_extra3Name":"","m_extra3Type":0,"m_extra3Value":"","m_extra4Name":"","m_extra4Type":0,"m_extra4Value":"","m_extra5Name":"","m_extra5Type":0,"m_extra5Value":"","m_extra6Name":"","m_extra6Type":0,"m_extra6Value":"","m_flags":0,"m_mimeType":"","m_packageName":"com.android.chrome","m_target":"Activity","useCustomCategory":false,"disableLogging":false,"m_SIGUID":3782921385505326332,"m_classType":"SendIntentAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Stempelseite in Chrome; application_id -> Chrome nimmt jedes Mal denselben Tab"},{"m_delayInMilliSeconds":0,"m_delayInSeconds":6,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":7855430079585767686,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"dictionaryKeys":{"keys":[]},"forceScreenRefresh":true,"includeOverlays":false,"includeScreenLocation":true,"includeWithoutText":false,"isLocalVar":false,"variableName":"seite","disableLogging":false,"m_SIGUID":-3792989218603878556,"m_classType":"ReadScreenContentsAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Stempelseite lesen -> Woerterbuch seite (Text + Position)"},{"blockNextAction":true,"m_nonRoot":false,"m_script":"B=/sdcard/Download/stempeln\nmkdir -p $B\nDEBUG=0\nSOLL=505\nORTE=\"\"\nnote() { cmd notification post -S bigtext -t \"$2\" \"$3\" \"$1\" </dev/null >/dev/null 2>&1; }\njetzt() { if [ -n \"$T_JETZT\" ]; then set -- $T_JETZT; else set -- $(date '+%Y %m %d %H %M %u %s'); fi\n  JJ=$1; MM=${2#0}; TT=${3#0}; HH=${4#0}; MI=${5#0}; WT=$6; EPOCH=$7; HEUTE=$1-$2-$3; NOW=$(( ${HH:-0}*60 + ${MI:-0} )); }\nhm() { echo \"$(( $1 / 60 )):$(( $1 % 60 / 10 ))$(( $1 % 10 ))\"; }\nminuten() { h=${1%%:*}; m=${1#*:}; h=${h#0}; m=${m#0}; echo $(( ${h:-0}*60 + ${m:-0} )); }\nmikro() { g=${1%%.*}; f=${1#*.}; [ \"$f\" = \"$1\" ] && f=0; f=${f}000000; f=${f%\"${f#??????}\"}; echo $(( g*1000000 + 1$f - 1000000 )); }\nwurzel() { n=$1; x=$n; [ $x -le 1 ] && { echo $x; return; }; y=$(( (x+1)/2 )); while [ $y -lt $x ]; do x=$y; y=$(( (x + n/x)/2 )); done; echo $x; }\nabst() { a=$(( $1 - $3 )); b=$(( $2 - $4 )); [ $a -lt 0 ] && a=$(( -a )); [ $b -lt 0 ] && b=$(( -b ))\n  if [ $a -gt 200000 ] || [ $b -gt 200000 ]; then echo 99999; return; fi\n  a=$(( a*1112/10000 )); b=$(( b*766/10000 )); wurzel $(( a*a + b*b )); }\n# naechster Ort -> TYP DIST RAD NAME (TYP leer = kein gueltiger Standort)\nort() { TYP=\"\"; DIST=\"\"; RAD=\"\"; NAME=\"\"; ORTLISTE=\"\"\n  case \"$1$2\" in *[0-9].[0-9]*[0-9].[0-9]*) ;; *) return ;; esac\n  la=$(mikro \"$1\"); lo=$(mikro \"$2\")\n  set -f; alt=$IFS; IFS='|'\n  for o in $ORTE; do\n    IFS=';'; set -- $o; IFS='|'\n    [ $# -ge 4 ] || continue\n    e=$(abst $la $lo $(mikro \"$2\") $(mikro \"$3\")); r=${5:-800}\n    if [ \"$e\" = 99999 ]; then ORTLISTE=\"$ORTLISTE\n$4: ueber 20 km\"; else ORTLISTE=\"$ORTLISTE\n$4: $e m\"; fi\n    if [ -z \"$DIST\" ] || [ \"$e\" -lt \"$DIST\" ]; then TYP=$1; DIST=$e; RAD=$r; NAME=$4; fi\n  done\n  IFS=$alt; set +f; }\n# Wörterbuch aus \"Bildschirminhalt lesen\" -> Zeilen \"x|y|Text\"\nelemente() { x=\"\"; y=\"\"\n  while IFS= read -r z; do\n    case \"$z\" in\n      \"-- [centerX]: \"*) x=${z#*: } ;;\n      \"-- [centerY]: \"*) y=${z#*: } ;;\n      \"-- [text]: \"*) s=${z#*\\]: }; [ -n \"$s\" ] && echo \"$x|$y|$s\" ;;\n    esac\n  done < \"$1\"; }\n# Stand aus Elementliste $1: STATUS (IN/OUT/?), PRES (Minuten, leer = nicht gelesen), LETZTE, BUCH, Knopf-Positionen\nstand() { STATUS=\"?\"; HOT=\"\"; PRES=\"\"; HOX=113; HOY=436; SSX=70; SSY=567; HUX=172; HUY=567; ZEITEN=\"\"\n  while IFS='|' read -r x y s; do\n    case \"$x$y\" in *[!0-9]*|\"\") continue ;; esac\n    if [ \"$x\" -lt 600 ]; then\n      case \"$s\" in\n        *\" HOME OFFICE\") HOT=$s; HOX=$x; HOY=$y\n          case \"$s\" in SORTIE*) STATUS=IN ;; ENTR*) STATUS=OUT ;; esac ;;\n        \"SUR SITE\") SSX=$x; SSY=$y ;;\n        HUB) HUX=$x; HUY=$y ;;\n        *\"Temps de pr\"*) p=${s%%[!0-9:]*}; case \"$p\" in *[0-9]:[0-9][0-9]) PRES=$(minuten \"$p\") ;; esac ;;\n      esac\n    elif [ \"$x\" -gt 720 ]; then\n      case \"$s\" in [0-2][0-9]:[0-5][0-9]) ZEITEN=\"$ZEITEN $s\" ;; esac\n    fi\n  done < \"$1\"\n  LETZTE=\"\"; BUCH=0; PAUSE=0; aus=\"\"\n  # Zeiten abwechselnd rein/raus; Luecken nach einem Ausstempeln 11:00-14:30 = Mittagspause\n  for s in $(for s in $ZEITEN; do echo $s; done | sort -u); do\n    LETZTE=$s; BUCH=$(( BUCH + 1 )); m=$(minuten $s)\n    if [ $(( BUCH % 2 )) = 0 ]; then aus=$m\n    elif [ -n \"$aus\" ]; then [ $aus -ge 660 ] && [ $aus -le 870 ] && PAUSE=$(( PAUSE + m - aus )); aus=\"\"; fi\n  done; }\nD=$(cat $B/aktuell.txt 2>/dev/null); [ -d \"$D\" ] || { D=$B/ohne-start; mkdir -p \"$D\"; }\nL=$D/log.txt; exec 2>>\"$L\"\nt() { echo \"$(date +%T) $*\" >> \"$L\"; }\ngrep -v 'ticket=' > \"$D/pruef.txt\" <<'ENDE_SEITE'\n{v=seite}\nENDE_SEITE\nelemente \"$D/pruef.txt\" > \"$D/pruef-el.txt\"\nstand \"$D/pruef-el.txt\"\nif [ -z \"$PRES\" ] && [ \"$STATUS\" = \"?\" ]; then\n  t \"Pruefung: Stempelseite nicht erkannt (Accueil?) - nochmal oeffnen\"\n  am start -a android.intent.action.VIEW -d \"https://aptime.cloud-horoquartz.fr/webquartz/ux/clock\" -p com.android.chrome --es com.android.browser.application_id macrodroid.stempeln </dev/null >/dev/null 2>&1\n  t \"am start rc=$?\"\n  sleep 7\nelse\n  t \"Pruefung: Stempelseite ok (Status=$STATUS, Praesenz=$PRES)\"\nfi\n","timeoutSeconds":25,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-1851445413565899689,"m_classType":"ShellScriptAction","m_comment":"Ist es die Stempelseite? Sonst (Accueil) nochmal oeffnen und 7 s warten","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"dictionaryKeys":{"keys":[]},"forceScreenRefresh":true,"includeOverlays":false,"includeScreenLocation":true,"includeWithoutText":false,"isLocalVar":false,"variableName":"seite","disableLoggi