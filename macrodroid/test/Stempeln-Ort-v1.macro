"disableLogging":false,"m_SIGUID":-2696870459390389940,"m_classType":"IfConditionAction","m_constraintList":[{"disableLogging":false,"m_SIGUID":-7429053172074282588,"m_classType":"MacroDroidVariableConstraint","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"checkCase":false,"dictionaryKeys":{"keys":[]},"dictionaryType":0,"enableRegex":false,"m_booleanValue":true,"m_doubleValue":0.0,"m_intCompareVariable":false,"m_intGreaterThan":false,"m_intLessThan":false,"m_intNotEqual":false,"m_intValue":0,"m_stringComparisonType":0,"m_stringEqual":true,"m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"debug","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true}}],"m_isDisabled":false,"m_isOrCondition":false,"childrenCollapsed":false,"dontLogIfConditionIsFalse":false,"m_comment":"nur wenn debug"},{"disableLogging":false,"m_SIGUID":-6144617056355443049,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v1 | Screenshot A vor Tipp","m_comment":""},{"disableLogging":false,"m_SIGUID":-4221410873228198327,"m_classType":"TakeScreenshotAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_option":0,"m_useSmtpEmail":false,"m_mechanismOption":0,"m_saveToJpeg":false,"m_comment":"Debug-Screenshot: A vor Tipp"},{"m_delayInMilliSeconds":0,"m_delayInSeconds":1,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-2283492659988540399,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":-5895546739687225385,"m_classType":"EndIfAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":-831062118835375906,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v1 | 4 Ort bestimmen und passenden Knopf tippen (Shizuku)","m_comment":""},{"blockNextAction":true,"m_nonRoot":false,"m_script":"LAT=\"{last_loc_lat}\"\nLON=\"{last_loc_long}\"\nORTE=\"{v=stempel_orte}\"\nF=/sdcard/Download/stempeln.txt\nnote() { cmd notification post -S bigtext -t \"Stempeln\" stempeln \"$1\" </dev/null >/dev/null 2>&1; }\nERG=$(echo \"$ORTE\" | tr '|' '\\n' | awk -F';' -v la=\"$LAT\" -v lo=\"$LON\" '\nfunction rad(x){ return x*3.14159265358979/180 }\nNF>=4 { dl=rad($2-la); dn=rad($3-lo); a=sin(dl/2)^2+cos(rad(la))*cos(rad($2))*sin(dn/2)^2;\n        d=2*6371000*atan2(sqrt(a),sqrt(1-a)); if (best==\"\" || d<best) { best=d; typ=$1; name=$4 } }\nEND { if (best==\"\") print \"KEIN;0;-\"; else printf \"%s;%d;%s\\n\", typ, best, name }')\nTYP=${ERG%%;*}; REST=${ERG#*;}; DIST=${REST%%;*}; NAME=${REST#*;}\ncase \"$TYP\" in\n  HO)  X=113; Y=436; KNOPF=\"HOME OFFICE\" ;;\n  SS)  X=70;  Y=567; KNOPF=\"SUR SITE\" ;;\n  HUB) X=172; Y=567; KNOPF=\"HUB\" ;;\n  *)   X=\"\"; KNOPF=\"\" ;;\nesac\nif [ -z \"$LAT\" ] || [ \"$LAT\" = \"0.0\" ] || [ -z \"$X\" ]; then\n  echo \"$(date) KEIN STANDORT lat=$LAT lon=$LON\" >> $F\n  note \"Kein Standort - nichts gestempelt\"\nelif [ \"$DIST\" -gt 800 ]; then\n  echo \"$(date) KEIN BEKANNTER ORT lat=$LAT lon=$LON naechster=$NAME ${DIST}m\" >> $F\n  note \"Kein bekannter Ort (naechster: $NAME, $DIST m) - nichts gestempelt\"\nelse\n  input tap $X $Y </dev/null >/dev/null 2>&1\n  RC=$?\n  echo \"$(date) $NAME ${DIST}m -> $KNOPF tap $X $Y rc=$RC\" >> $F\n  note \"$KNOPF gedrueckt ($NAME, $DIST m)\"\nfi","timeoutSeconds":20,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-7130147689502975628,"m_classType":"ShellScriptAction","m_comment":"Naechsten bekannten Ort bestimmen (Variable stempel_orte), passenden Knopf per Shizuku tippen, Hinweis als Benachrichtigung","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":-6203015976031202323,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v1 | 5 warte 5 s","m_comment":""},{"m_delayInMilliSeconds":0,"m_delayInSeconds":5,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-6502016247743504577,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":-4528870710285649080,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v1 | 6 Seite neu laden (gleicher Tab)","m_comment":""},{"EXTRA_TYPE_AUTO":0,"EXTRA_TYPE_BOOLEAN":2,"EXTRA_TYPE_DOUBLE":6,"EXTRA_TYPE_FLOAT":5,"EXTRA_TYPE_INT":3,"EXTRA_TYPE_LONG":4,"EXTRA_TYPE_STRING":1,"EXTRA_TYPE_STRING_ARRAY":7,"EXTRA_TYPE_URI":8,"additionalExtras":[],"m_action":"android.intent.action.VIEW","m_className":"","m_data":"https://aptime.cloud-horoquartz.fr/webquartz/ux/clock","m_extra1Name":"com.android.browser.application_id","m_extra1Type":1,"m_extra1Value":"macrodroid.stempeln","m_extra2Name":"","m_extra2Type":0,"m_extra2Value":"","m_extra3Name":"","m_extra3Type":0,"m_extra3Value":"","m_extra4Name":"","m_extra4Type":0,"m_extra4Value":"","m_extra5Name":"","m_extra5Type":0,"m_extra5Value":"","m_extra6Name":"","m_extra6Type":0,"m_extra6Value":"","m_flags":0,"m_mimeType":"","m_packageName":"com.android.chrome","m_target":"Activity","useCustomCategory":false,"disableLogging":false,"m_SIGUID":-2762487296049323916,"m_classType":"SendIntentAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Stempelseite in Chrome; application_id -> Chrome nimmt jedes Mal denselben Tab"},{"m_delayInMilliSeconds":0,"m_delayInSeconds":7,"m_useAlarm":true,"unitForVariables":0,"disable