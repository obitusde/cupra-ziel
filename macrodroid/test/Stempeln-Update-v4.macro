{"globalVariables":[{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"seite","m_stringValue":"","m_type":4,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":true,"m_decimalValue":0.0,"m_intValue":0,"m_name":"stempel_aktiv","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"frei_bis","m_stringValue":"","m_type":2,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":true,"m_decimalValue":0.0,"m_intValue":0,"m_name":"shizuku_ok","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"seite_ok","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"agenda_ok","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"stempel_paket","m_stringValue":"","m_type":2,"supportsInput":true,"supportsOutput":true}],"macro":{"aiGenerated":0,"breakpoints":[],"disabledTimestamp":0,"exportedActionBlocks":[],"exportedSharedScenes":[],"forceEvenIfNotEnabledTimestamp":0,"isActionBlock":false,"isExtra":false,"isFavourite":false,"lastEditedTimestamp":1793087286224,"localVariables":[],"localVarsAlphabetical":true,"loggingLevel":0,"m_GUID":-5596432972484345053,"m_actionList":[{"disableLogging":false,"m_SIGUID":7113556574049750307,"m_classType":"SetVariableAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"booleanDictionaryKeys":{"keys":[]},"dictionaryKeys":[],"dictionaryOrArrayType":-1,"existingManualKeyType":0,"m_booleanInvert":false,"m_darkMode":-1,"m_doubleRandomMax":0.0,"m_doubleRandomMin":0.0,"m_falseLabel":"","m_intExpression":false,"m_intRandom":false,"m_intRandomMax":0,"m_intRandomMin":0,"m_intValueDecrement":false,"m_intValueIncrement":false,"m_newBooleanValue":false,"m_newDoubleValue":0.0,"m_newIntValue":0,"m_trueLabel":"","m_userPrompt":false,"m_userPromptEmptyAtStart":false,"m_userPromptPassword":false,"m_userPromptShowCancel":false,"m_userPromptStopAfterCancel":false,"m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"stempel_paket","m_stringValue":"","m_type":2,"supportsInput":true,"supportsOutput":true},"m_comment":"Alte Antwort loeschen","m_newStringValue":""},{"requestConfig":{"allowAnyCertificate":false,"basicAuthEnabled":false,"basicAuthPassword":"","basicAuthUsername":"","blockNextAction":true,"clientCertEnabled":false,"clientCertKeyStoreDisplayName":"","clientCertKeyStoreUri":"","clientCertPassword":"","contentBodyDynamicFileName":"","contentBodyFileDisplayName":"","contentBodyFileUri":"","contentBodyFolderDisplayName":"","contentBodyFolderUri":"","contentBodySource":0,"contentBodyText":"","contentType":"","followRedirects":true,"headerParams":[],"localFileUri":"","prettifyJson":false,"queryParams":[],"requestTimeOutSeconds":30,"requestType":0,"responseVariableName":"stempel_paket","saveResponseFileName":"","saveResponseFolderPathDisplayName":"","saveResponseFolderPathUri":"","saveResponseType":1,"saveReturnCodeToVariable":false,"saveReturnHeadersToVariable":false,"urlToOpen":"https://raw.githubusercontent.com/obitusde/cupra-ziel/main/macrodroid/test/stempeln/paket.txt","useLocalFileUri":false,"useStaticContentBodyFile":true},"disableLogging":false,"m_SIGUID":-9128470184399241224,"m_classType":"HttpRequestAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Stempel-Skripte von GitHub holen -> Variable stempel_paket"},{"blockNextAction":true,"m_nonRoot":false,"m_script":"# Stempeln Update (Huelle v4): Ortsliste schreiben, Stempel-Skripte aus dem Paket installieren\nB=/sdcard/Download/stempeln; S=$B/skripte; N=$B/skripte-neu\nmkdir -p $B\nnote() { cmd notification post -S bigtext -t \"Stempeln Update\" stempeln \"$(date +%H:%M) · $1\" </dev/null >/dev/null 2>&1; }\nORTE_NEU=\"\"\n[ -n \"$ORTE_NEU\" ] && print -r -- \"$ORTE_NEU\" > $B/orte.txt\ncat > $B/paket-github.txt <<'ENDE_PAKET_GH'\n{v=stempel_paket}\nENDE_PAKET_GH\ncat > $B/paket-eingebaut.txt <<'ENDE_PAKET_EB'\n#STEMPELPAKET 4.0\n# Stempel-Skripte fuer MacroDroid (Makro \"Stempeln Update\" packt aus). Nicht von Hand aendern.\n#DATEI kopf.sh\n# Stempel-Skripte - gemeinsamer Kopf (Version siehe SKV)\n# Wird von den Makro-Huellen geladen: vorher gesetzt LAT LON FREI TEXT (Magic Text aus MacroDroid)\nSKV=4.0\nB=/sdcard/Download/stempeln\nmkdir -p $B\nDEBUG=0\nSOLL=505\n# Orte: eigene Datei auf dem Handy (schreibt das private Makro \"Stempeln Update\"), nie im Repo\nORTE=$(cat $B/orte.txt 2>/dev/null)\n# Meldung mit Uhrzeit vorne: note TEXT TITEL TAG\nnote() { cmd notification post -S bigtext -t \"$2\" \"$3\" \"$(date +%H:%M) · $1\" </dev/null >/dev/null 2>&1; }\n# Vorschlag an den Waechter: Text steht im Titel (MacroDroid zeigt not_title), Kennung \"Stempel-Vorschlag\" im Text\nsignal() { cmd notification post -S bigtext -t \"$(date +%H:%M) · $1\" vorschlag \"Stempel-Vorschlag\" </dev/null >/dev/null 2>&1; }\njetzt() { if [ -n \"$T_JETZT\" ]; then set -- $T_JETZT; else set -- $(date '+%Y %m %d %H %M %u %s'); fi\n  JJ=$1; MM=${2#0}; TT=${3#0}; HH=${4#0}; MI=${5#0}; WT=$6; EPOCH=$7; HEUTE=$1-$2-$3; NOW=$(( ${HH:-0}*60 + ${MI:-0} )); }\nhm() { echo \"$(( $1 / 60 )):$(( $1 % 60 / 10 ))$(( $1 % 10 ))\"; }\nminuten() { h=${1%%:*}; m=${1#*:}; h=${h#0}; m=${m#0}; echo $(( ${h:-0}*60 + ${m:-0} )); }\nmikro() { g=${1%%.*}; f=${1#*.}; [ \"$f\" = \"$1\" ] && f=0; f=${f}000000; f=${f%\"${f#??????}\"}; echo $(( g*1000000 + 1$f - 1000000 )); }\nwurzel() { n=$1; x=$n; [ $x -le 1 ] && { echo $x; return; }; y=$(( (x+1)/2 )); while [ $y -lt $x ]; do x=$y; y=$(( (x + n/x)/2 )); done; echo $x; }\nabst() { a=$(( $1 - $3 )); b=$(( $2 - $4 )); [ $a -lt 0 ] && a=$(( -a )); [ $b -lt 0 ] && b=$(( -b ))\n  if [ $a -gt 200000 ] || [ $b -gt 200000 ]; then echo 99999; return; fi\n  a=$(( a*1112/10000 )); b=$(( b*766/10000 )); wurzel $(( a*a + b*b )); }\n# naechster Ort zu $1 $2 -> TYP DIST RAD NAME (TYP leer = kein gueltiger Standort)\nort() { TYP=\"\"; DIST=\"\"; RAD=\"\"; NAME=\"\"\n  case \"$1$2\" in *[0-9].[0-9]*[0-9].[0-9]*) ;; *) return ;; esac\n  la=$(mikro \"$1\"); lo=$(mikro \"$2\")\n  set -f; alt=$IFS; IFS='|'\n  for o in $ORTE; do\n    IFS=';'; set -- $o; IFS='|'\n    [ $# -ge 4 ] || continue\n    e=$(abst $la $lo $(mikro \"$2\") $(mikro \"$3\")); r=${5:-800}\n    if [ -z \"$DIST\" ] || [ \"$e\" -lt \"$DIST\" ]; then TYP=$1; DIST=$e; RAD=$r; NAME=$4; fi\n  done\n  IFS=$alt; set +f; }\n# Knopf-Text fuer Typ $1 (nur der Knopf, ohne Ortsname)\nlabel() { case \"$1\" in HO) echo \"HOME OFFICE\" ;; HUB) echo \"HUB\" ;; SS) echo \"SUR SITE\" ;; *) echo \"unbekannter Ort, du tippst selbst\" ;; esac; }\n# Welcher Knopf fuer Richtung $1 (EIN/AUS)? AUS = Knopf vom Einstempeln (Z_ORT), sonst Standort (vorher ort aufrufen)\n# -> KTYP KNAME LABEL (KTYP leer = unbekannter Ort)\nwahl() { if [ \"$1\" = AUS ] && [ -n \"$Z_ORT\" ]; then KTYP=$Z_ORT; KNAME=$Z_NAME\n  elif [ -n \"$TYP\" ] && [ \"$DIST\" -le \"$RAD\" ]; then KTYP=$TYP; KNAME=$NAME\n  else KTYP=\"\"; KNAME=\"\"; fi\n  LABEL=$(label \"$KTYP\"); }\n# Woerterbuch aus \"Bildschirminhalt lesen\" -> Zeilen \"x|y|Text\"\nelemente() { x=\"\"; y=\"\"\n  while IFS= read -r z; do\n    case \"$z\" in\n      \"-- [centerX]: \"*) x=${z#*: } ;;\n      \"-- [centerY]: \"*) y=${z#*: } ;;\n      \"-- [text]: \"*) s=${z#*\\]: }; [ -n \"$s\" ] && echo \"$x|$y|$s\" ;;\n    esac\n  done < \"$1\"; }\n# Stand aus Elementliste $1: STATUS (IN/OUT/?), PRES (Minuten, leer = nicht gelesen), LETZTE, BUCH, PAUSE, Knopf-Positionen\n# AGENDA=1 nur wenn die Agenda fertig geladen ist (Stundenzahl 23:00 in der Agenda-Spalte) - sonst ist der Knopf-Text unzuverlaessig\nstand() { STATUS=\"?\"; HOT=\"\"; PRES=\"\"; AGENDA=0; HOX=113; HOY=436; SSX=70; SSY=567; HUX=172; HUY=567; ZEITEN=\"\"\n  while IFS='|' read -r x y s; do\n    case \"$x$y\" in *[!0-9]*|\"\") continue ;; esac\n    if [ \"$x\" -lt 600 ]; then\n      case \"$s\" in\n        *\" HOME OFFICE\") HOT=$s; HOX=$x; HOY=$y\n          case \"$s\" in SORTIE*) STATUS=IN ;; ENTR*) STATUS=OUT ;; esac ;;\n        \"SUR SITE\") SSX=$x; SSY=$y ;;\n        HUB) HUX=$x; HUY=$y ;;\n        *\"Temps de pr\"*) p=${s%%[!0-9:]*}; case \"$p\" in *[0-9]:[0-9][0-9]) PRES=$(minuten \"$p\") ;; esac ;;\n      esac\n    elif [ \"$x\" -le 720 ]; then\n      [ \"$s\" = \"23:00\" ] && AGENDA=1\n    else\n      case \"$s\" in [0-2][0-9]:[0-5][0-9]) ZEITEN=\"$ZEITEN $s\" ;; esac\n    fi\n  done < \"$1\"\n  # halb geladen: Knopf/Zeiten nicht verwenden\n  HALB=0; [ $AGENDA = 1 ] || { [ -n \"$HOT\" ] && HALB=1; STATUS=\"?\"; PRES=\"\"; ZEITEN=\"\"; }\n  LETZTE=\"\"; BUCH=0; PAUSE=0; aus=\"\"\n  # Zeiten abwechselnd rein/raus; Luecken nach einem Ausstempeln 11:00-14:30 = Mittagspause\n  for s in $(for s in $ZEITEN; do echo $s; done | sort -u); do\n    LETZTE=$s; BUCH=$(( BUCH + 1 )); m=$(minuten $s)\n    if [ $(( BUCH % 2 )) = 0 ]; then aus=$m\n    elif [ -n \"$aus\" ]; then [ $aus -ge 660 ] && [ $aus -le 870 ] && PAUSE=$(( PAUSE + m - aus )); aus=\"\"; fi\n  done; }\n# Lauf-Ordner (von start.sh angelegt)\nlauf() { D=$(cat $B/aktuell.txt 2>/dev/null); [ -d \"$D\" ] || { D=$B/lauf; mkdir -p \"$D\"; }\n  L=$D/log.txt; exec 2>>\"$L\"; }\nt() { [ $DEBUG = 1 ] && echo \"$(date +%T) $*\" >> \"$L\"; }\n#DATEI start.sh\n# Start von Stempeln / Stand: Lauf-Ordner, Sperre, aufs Entsperren warten, Leiste schliessen\njetzt\necho $EPOCH > $B/lock.txt\nD=$B/lauf; rm -rf \"$D\"; mkdir -p \"$D\"; echo \"$D\" > $B/aktuell.txt\nL=$D/log.txt; exec 2>>\"$L\"\nt \"$TEXT (Skripte v$SKV) - Start\"\ngesperrt() { dumpsys window </dev/null 2>&1 | grep -cE 'isKeyguardShowing=true|mShowingLockscreen=true|mDreamingLockscreen=true'; }\nn=0\nwhile [ \"$(gesperrt)\" != 0 ] && [ $n -lt 60 ]; do\n  [ $n = 0 ] && note \"Bitte entsperren - dann geht es weiter\" \"Stempeln\" stempeln\n  sleep 1; n=$(( n + 1 ))\ndone\ncmd statusbar collapse </dev/null >/dev/null 2>&1\nt \"entsperrt nach $n s, Leiste zu\"\nnote \"$TEXT ...\" \"Stempeln\" stempeln\n#DATEI neu.sh\n# Stempelseite nicht erkannt (Accueil oder noch am Laden): nochmal oeffnen, 7 s warten\nlauf\nam start -a android.intent.action.VIEW -d \"https://aptime.cloud-horoquartz.fr/webquartz/ux/clock\" -p com.android.chrome --es com.android.browser.application_id macrodroid.stempeln </dev/null >/dev/null 2>&1\nsleep 7\n#DATEI haupt.sh\n# Stempeln: Stand lesen, Knopf waehlen, tippen (oder bewusst nicht)\nlauf\njetzt\ncp $B/seite-roh.txt \"$D/seite-vor.txt\" 2>/dev/null\nelemente \"$D/seite-vor.txt\" > \"$D/elemente-vor.txt\"\nstand \"$D/elemente-vor.txt\"\nt \"Seite vorher: Status=$STATUS Praesenz=$PRES Letzte=$LETZTE Buchungen=$BUCH Agenda=$AGENDA\"\nort \"$LAT\" \"$LON\"\nt \"Standort -> $TYP $NAME $DIST m (Radius $RAD)\"\n# Vorschlag (Knopf in der Erinnerung), gilt 30 min\nWUNSCH=\"\"; V_ZIEL=\"\"; V_ZEIT=0; V_LABEL=\"\"\n[ -f $B/vorschlag.txt ] && . $B/vorschlag.txt && [ $(( EPOCH - ${V_ZEIT:-0} )) -lt 1800 ] && WUNSCH=$V_ZIEL\n[ -n \"$WUNSCH\" ] || V_LABEL=\"\"\nrm -f $B/vorschlag.txt\nZ_DATUM=\"\"; Z_ORT=\"\"; Z_NAME=\"\"; [ -f $B/zustand.txt ] && . $B/zustand.txt\n[ \"$Z_DATUM\" = \"$HEUTE\" ] || { Z_ORT=\"\"; Z_NAME=\"\"; }\n# Ausstempeln mit dem Knopf vom Einstempeln, Einstempeln nach Standort\nif [ \"$STATUS\" = IN ]; then wahl AUS; else wahl EIN; fi\nt \"Wunsch '${WUNSCH:-keiner}' ($V_LABEL), jetzt: $LABEL\"\nAKTION=keine; KORR=\"\"\nif [ \"$HALB\" = 1 ]; then\n  ERGT=\"Stempelseite nicht fertig geladen (30 s gewartet) - nichts getippt, bitte selbst pruefen\"\nelif [ \"$STATUS\" = \"?\" ]; then\n  ERGT=\"Stempelseite nicht gelesen - nichts getippt, bitte selbst pruefen\"\nelif [ \"$WUNSCH\" = EIN ] && [ \"$STATUS\" = IN ]; then\n  ERGT=\"Du warst schon eingestempelt - nichts getippt\"; KORR=1\nelif [ \"$WUNSCH\" = AUS ] && [ \"$STATUS\" = OUT ]; then\n  ERGT=\"Du warst schon ausgestempelt - nichts getippt\"; KORR=1\nelif [ -n \"$V_LABEL\" ] && [ \"$V_LABEL\" != \"$LABEL\" ]; then\n  ERGT=\"Ort passt nicht mehr zur Erinnerung ($V_LABEL, jetzt $LABEL) - nichts getippt. Stimmt $LABEL, starte Stempeln nochmal\"; KORR=1\nelif [ -z \"$KTYP\" ]; then\n  AKTION=manuell\n  ERGT=\"Unbekannter Ort\"\n  note \"Unbekannter Ort - tippe selbst auf der Seite den passenden Knopf. Ich lese in 60 s nach.\" \"Stempeln\" stempeln\n  sleep 60\nelse\n  case \"$KTYP\" in\n    HO)  X=$HOX; Y=$HOY ;;\n    SS)  X=$SSX; Y=$SSY ;;\n    HUB) X=$HUX; Y=$HUY ;;\n  esac\n  input tap $X $Y </dev/null >/dev/null 2>&1\n  t \"Tipp $LABEL bei $X,$Y rc=$?\"\n  AKTION=tipp; ERGT=$LABEL\nfi\n{ echo \"A_AKTION=$AKTION\"; echo \"A_STATUS=$STATUS\"; echo \"A_TYP=$KTYP\"; echo \"A_NAME='$KNAME'\"; echo \"A_TEXT='$ERGT'\"; echo \"A_KORR=$KORR\"; } > \"$D/aktion.txt\"\nt \"Aktion: $AKTION - $ERGT\"\n#DATEI ende.sh\n# Stempeln / Stand: neuen Stand lesen, Buchung pruefen, Zustand fuer den Waechter speichern, Meldung\nlauf\njetzt\ncp $B/seite-roh.txt \"$D/seite-nach.txt\" 2>/dev/null\nelemente \"$D/seite-nach.txt\" > \"$D/elemente-nach.txt\"\nstand \"$D/elemente-nach.txt\"\nt \"Seite nachher: Status=$STATUS Praesenz=$PRES Letzte=$LETZTE Buchungen=$BUCH Pause=$PAUSE Agenda=$AGENDA\"\nA_AKTION=keine; A_STATUS=\"?\"; A_TYP=\"\"; A_NAME=\"\"; A_TEXT=\"\"; A_KORR=\"\"\n[ -f \"$D/aktion.txt\" ] && . \"$D/aktion.txt\"\nZ_DATUM=\"\"; Z_ORT=\"\"; Z_NAME=\"\"; [ -f $B/zustand.txt ] && . $B/zustand.txt\n[ \"$Z_DATUM\" = \"$HEUTE\" ] || { Z_ORT=\"\"; Z_NAME=\"\"; }\nort \"$LAT\" \"$LON\"\nif [ -n \"$PRES\" ] && [ \"$STATUS\" != \"?\" ]; then\n  # Knopf merken, mit dem eingestempelt wurde (fuers Ausstempeln)\n  case \"$A_AKTION\" in\n    tipp) Z_ORT=$A_TYP; Z_NAME=$A_NAME ;;\n    manuell) Z_ORT=\"\"; Z_NAME=\"\" ;;\n    *) if [ -z \"$Z_ORT\" ] && [ \"$STATUS\" = IN ]; then wahl EIN; Z_ORT=$KTYP; Z_NAME=$KNAME; fi ;;\n  esac\n  { echo \"Z_DATUM=$HEUTE\"; echo \"Z_STATUS=$STATUS\"; echo \"Z_PRES=$PRES\"; echo \"Z_LESE=$EPOCH\"; echo \"Z_LETZTE=$LETZTE\"; echo \"Z_BUCH=$BUCH\"\n    echo \"Z_ORT=$Z_ORT\"; echo \"Z_NAME='$Z_NAME'\"; } > $B/zustand.txt\n  ZL=\"\"; [ -n \"$Z_ORT\" ] && ZL=\" - $(label \"$Z_ORT\")\"\n  REST=$(( SOLL - PRES ))\n  if [ \"$STATUS\" = IN ]; then\n    PZU=0; [ $PAUSE = 0 ] && [ $NOW -lt 870 ] && PZU=45\n    if [ $REST -gt 0 ]; then INFO=\"heute $(hm $PRES) - noch $(hm $REST) -> fertig um $(hm $(( (NOW + REST + PZU) % 1440 )))\"\n      [ $PZU -gt 0 ] && INFO=\"$INFO (mit 45 min Pause)\"\n    else INFO=\"heute $(hm $PRES) - 8 h 25 schon voll\"; fi\n    KOPF=\"Eingestempelt${LETZTE:+ $LETZTE}$ZL\"\n  else\n    if [ $REST -gt 0 ]; then INFO=\"heute $(hm $PRES) - noch $(hm $REST) offen\"\n      L2=$(minuten \"${LETZTE:-0:00}\")\n      [ $L2 -ge 660 ] && [ $L2 -le 870 ] && INFO=\"$INFO\nPause 30 min bis $(hm $(( L2 + 30 ))), 45 min bis $(hm $(( L2 + 45 )))\"\n    else INFO=\"heute $(hm $PRES) - Feierabend\"; fi\n    KOPF=\"Ausgestempelt${LETZTE:+ $LETZTE}\"\n    [ \"$A_AKTION\" = tipp ] && KOPF=\"$KOPF - $(label \"$A_TYP\")\"\n  fi\n  if [ \"$A_AKTION\" = tipp ] && [ \"$STATUS\" = \"$A_STATUS\" ]; then\n    MELD=\"ACHTUNG: $A_TEXT getippt, aber der Stand hat sich nicht geaendert ($KOPF). Bitte pruefen!\"\n  elif [ \"$A_AKTION\" = manuell ] && [ \"$STATUS\" != \"$A_STATUS\" ]; then MELD=\"$KOPF (von Hand)\n$INFO\"\n  elif [ -n \"$A_KORR\" ]; then MELD=\"$A_TEXT - Stand gemerkt:\n$KOPF\n$INFO\"\n  elif [ -n \"$A_TEXT\" ] && [ \"$A_AKTION\" != tipp ]; then MELD=\"$A_TEXT\n$KOPF - $INFO\"\n  else MELD=\"$KOPF\n$INFO\"; fi\n  # gemerkte Erinnerung passt nicht mehr zum Stand -> Waechter fragt neu\n  rm -f $B/vorschlag.txt\nelse\n  if [ \"$HALB\" = 1 ]; then MELD=\"Stempelseite nicht fertig geladen (30 s gewartet) - Stand nicht gelesen, bitte selbst pruefen\"\n  else MELD=\"Stempelseite nicht gelesen - bitte selbst pruefen\"; fi\n  [ \"$A_AKTION\" = tipp ] && MELD=\"$A_TEXT getippt, aber danach: $MELD\"\n  [ \"$A_AKTION\" = keine ] && [ -n \"$A_TEXT\" ] && MELD=$A_TEXT\nfi\nt \"Meldung: $MELD\"\nnote \"$MELD\" \"Stempeln\" stempeln\nrm -f $B/lock.txt\n#DATEI waechter.sh\n# Waechter: alle 5 min (07:30-19:30) - Arbeitstag? Stand + Standort -> Erinnerung oder nichts\njetzt\nW=$B/waechter.log\nw() { [ $DEBUG = 1 ] && echo \"$(date '+%d.%m. %H:%M') $*\" >> $W; }\nexec 2>>$B/fehler.log\n# laeuft gerade Stempeln?\n[ -f $B/lock.txt ] && [ $(( EPOCH - $(cat $B/lock.txt) )) -lt 240 ] && { w \"Stempeln laeuft - nichts\"; exit 0; }\n# Arbeitstag? Mo-Fr, kein Waadtlaender Feiertag, nicht frei\ntagnr() { y=$1; m=$2; d=$3; [ $m -le 2 ] && y=$(( y - 1 )); era=$(( y / 400 )); yoe=$(( y - era*400 ))\n  if [ $m -gt 2 ]; then mp=$(( m - 3 )); else mp=$(( m + 9 )); fi\n  doy=$(( (153*mp + 2)/5 + d - 1 )); doe=$(( yoe*365 + yoe/4 - yoe/100 + doy )); echo $(( era*146097 + doe - 719468 )); }\nfeiertag() { y=$1; n=$2\n  a=$(( y % 19 )); b=$(( y / 100 )); c=$(( y % 100 )); d=$(( b / 4 )); e=$(( b % 4 )); f=$(( (b + 8) / 25 )); g=$(( (b - f + 1) / 3 ))\n  h=$(( (19*a + b - d - g + 15) % 30 )); i=$(( c / 4 )); k=$(( c % 4 )); l=$(( (32 + 2*e + 2*i - h - k) % 7 )); m=$(( (a + 11*h + 22*l) / 451 ))\n  om=$(( (h + l - 7*m + 114) / 31 )); od=$(( (h + l - 7*m + 114) % 31 + 1 )); os=$(tagnr $y $om $od)\n  s1=$(tagnr $y 9 1); wd=$(( (s1 + 4) % 7 )); bettag=$(( s1 + (7 - wd) % 7 + 15 ))\n  for f in $(tagnr $y 1 1) $(tagnr $y 1 2) $(( os - 2 )) $(( os + 1 )) $(( os + 39 )) $(( os + 50 )) $(tagnr $y 8 1) $bettag $(tagnr $y 12 25); do\n    [ $f = $n ] && return 0; done; return 1; }\nHN=$(tagnr $JJ $MM $TT)\nFN=0\ncase \"$FREI\" in *[0-9].*[0-9].*[0-9]*) fd=${FREI%%.*}; r=${FREI#*.}; fm=${r%%.*}; fy=${r#*.}; fd=${fd#0}; fm=${fm#0}; [ ${#fy} = 2 ] && fy=20$fy; FN=$(tagnr $fy $fm $fd) ;; esac\nGRUND=\"\"\n[ $WT -gt 5 ] && GRUND=\"Wochenende\"\nfeiertag $JJ $HN && GRUND=\"Feiertag\"\n[ $HN -lt $FN ] && GRUND=\"frei bis $FREI\"\nruhe() { [ \"$(cat $B/ruhe.txt 2>/dev/null)\" = \"$HEUTE\" ] && exit 0\n  echo \"$HEUTE\" > $B/ruhe.txt; w \"Ruhe: $1\"; note \"Stempel-Ruhe · $1\" \"Stempel-Ruhe\" ruhe; exit 0; }\n[ -n \"$GRUND\" ] && ruhe \"$GRUND\"\n# Stand vom letzten Stempeln\nZ_DATUM=\"\"; Z_STATUS=OUT; Z_PRES=0; Z_LESE=$EPOCH; Z_LETZTE=\"\"; Z_BUCH=0; Z_ORT=\"\"; Z_NAME=\"\"\n[ -f $B/zustand.txt ] && . $B/zustand.txt\n[ \"$Z_DATUM\" != \"$HEUTE\" ] && { Z_STATUS=OUT; Z_PRES=0; Z_LESE=$EPOCH; Z_LETZTE=\"\"; Z_BUCH=0; Z_ORT=\"\"; Z_NAME=\"\"; }\nP=$Z_PRES; [ \"$Z_STATUS\" = IN ] && P=$(( Z_PRES + (EPOCH - Z_LESE) / 60 ))\n[ \"$Z_STATUS\" = OUT ] && [ $P -ge $SOLL ] && ruhe \"Feierabend ($(hm $P))\"\n# spaeter?\n[ -f $B/spaeter.txt ] && [ $EPOCH -lt $(cat $B/spaeter.txt) ] && { w \"spaeter - nichts\"; exit 0; }\nort \"$LAT\" \"$LON\"\nDA=\"\"; [ -n \"$TYP\" ] && [ \"$DIST\" -le \"$RAD\" ] && DA=$TYP\nZIEL=\"\"; MSG=\"\"; GRUND=\"\"; WDH=15\nif [ \"$Z_STATUS\" = IN ]; then\n  if [ $P -ge $SOLL ]; then ZIEL=AUS; GRUND=\"8 h 25 voll\"; UE=$(( P - SOLL ))\n    MSG=\"8 h 25 voll seit $(hm $(( (NOW - UE + 1440) % 1440 )))\"; [ $UE -ge 5 ] && MSG=\"$MSG (+$UE min)\"; MSG=\"$MSG - ausstempeln?\"\n  elif [ $NOW -ge 705 ] && [ $NOW -lt 870 ] && [ $(minuten \"${Z_LETZTE:-0:00}\") -lt 660 ]; then\n    ZIEL=AUS; GRUND=\"Mittagspause\"; MSG=\"Mittagspause (heute $(hm $P)) - ausstempeln?\"\n  elif [ \"$Z_ORT\" = SS ] || [ \"$Z_ORT\" = HUB ]; then\n    if [ -n \"$TYP\" ] && { [ \"$TYP\" != SS ] && [ \"$TYP\" != HUB ] || [ \"$DIST\" -gt $(( RAD + 200 )) ]; }; then\n      ZIEL=AUS; GRUND=\"Buero verlassen\"; MSG=\"Buero verlassen (heute $(hm $P)) - ausstempeln?\"; fi\n  fi\nelif [ \"$Z_BUCH\" = 0 ]; then\n  case \"$DA\" in\n    SS|HUB) ZIEL=EIN; GRUND=\"Ankunft\"; MSG=\"Angekommen - einstempeln?\"; [ $NOW -lt 480 ] && WDH=9999 ;;\n    HO) if { [ $WT = 2 ] || [ $WT = 5 ]; } && [ $NOW -ge 450 ] && [ $NOW -lt 660 ]; then ZIEL=EIN; GRUND=\"Home Office\"; MSG=\"Zu Hause - einstempeln?\"\n        elif [ $NOW -ge 495 ] && [ $NOW -lt 660 ]; then ZIEL=EIN; GRUND=\"Home Office\"; MSG=\"Noch zu Hause - heute Home Office? Einstempeln?\"; fi ;;\n  esac\nelse\n  LZ=$(minuten \"${Z_LETZTE:-0:00}\")\n  if [ $LZ -ge 660 ] && [ $LZ -le 870 ] && [ $NOW -ge $(( LZ + 35 )) ] && [ $NOW -lt $(( LZ + 60 )) ]; then\n    ZIEL=EIN; GRUND=\"Pause vorbei\"; MSG=\"Pause seit $(( NOW - LZ )) min (heute $(hm $P)) - wieder einstempeln?\"\n  elif [ $LZ -ge 660 ] && [ $LZ -le 870 ] && [ $NOW -ge $(( LZ + 60 )) ] && [ -n \"$DA\" ]; then\n    # vielleicht am Badge eingestempelt - einmal nachfragen\n    ZIEL=EIN; GRUND=\"Nachfrage\"; WDH=9999\n    MSG=\"Seit $Z_LETZTE ausgestempelt ($(( NOW - LZ )) min) - schon wieder eingestempelt? Sonst jetzt einstempeln?\"; fi\nfi\nw \"Stand=$Z_STATUS heute=$(hm $P) Ort=${TYP:-?} ${DIST:-} m da=${DA:-nein} -> ${ZIEL:-nichts}\"\n[ -z \"$ZIEL\" ] && exit 0\nwahl $ZIEL\nMSG=\"$MSG → $LABEL\"\nV_ZIEL=\"\"; V_ZEIT=0; V_DATUM=\"\"; V_LABEL=\"\"; V_GRUND=\"\"\n[ -f $B/vorschlag-letzter.txt ] && . $B/vorschlag-letzter.txt\n# gleiche Frage (Richtung, Knopf und Grund) erst nach WDH Minuten wiederholen\nif [ \"$V_ZIEL\" = \"$ZIEL\" ] && [ \"$V_LABEL\" = \"$LABEL\" ] && [ \"$V_GRUND\" = \"$GRUND\" ] && [ \"$V_DATUM\" = \"$HEUTE\" ] && [ $(( (EPOCH - V_ZEIT) / 60 )) -lt $WDH ]; then exit 0; fi\n{ echo \"V_ZIEL=$ZIEL\"; echo \"V_ZEIT=$EPOCH\"; echo \"V_DATUM=$HEUTE\"; echo \"V_LABEL='$LABEL'\"; echo \"V_GRUND='$GRUND'\"; } > $B/vorschlag-letzter.txt\ncp $B/vorschlag-letzter.txt $B/vorschlag.txt\nw \"Vorschlag: $MSG\"\nsignal \"$MSG\"\n#DATEI spaeter.sh\n# Knopf [Spaeter]: 15 min keine Erinnerung\njetzt\nV_GRUND=\"\"; [ -f $B/vorschlag-letzter.txt ] && . $B/vorschlag-letzter.txt\necho $(( EPOCH + 900 )) > $B/spaeter.txt\nrm -f $B/vorschlag.txt\nnote \"Spaeter${V_GRUND:+: $V_GRUND} - Erinnerung wieder ab $(hm $(( (NOW + 15) % 1440 )))\" \"Stempeln\" spaeter\n#DATEI frei.sh\n# Stempeln Frei: Bestaetigung (FREI kommt aus der Huelle)\njetzt\ncase \"$FREI\" in\n  \"\") rm -f $B/ruhe.txt; note \"Keine freien Tage eingetragen - Erinnerungen sind an\" \"Stempeln\" stempeln ;;\n  *[0-9].*[0-9].*[0-9]*) rm -f $B/ruhe.txt; note \"Frei bis $FREI - bis dahin keine Erinnerungen (ab $FREI wieder)\" \"Stempeln\" stempeln ;;\n  *) note \"'$FREI' nicht verstanden - bitte als TT.MM.JJJJ eingeben (z. B. 03.11.2026)\" \"Stempeln\" stempeln ;;\nesac\n#DATEI VERSION\n4.0\n#ENDE 4.0\nENDE_PAKET_EB\nauspacken() { rm -rf $N; mkdir -p $N; v=\"\"; ok=0; d=\"\"\n  while IFS= read -r z; do\n    case \"$z\" in\n      \"#STEMPELPAKET \"*) v=${z#\"#STEMPELPAKET \"} ;;\n      \"#DATEI \"*) d=$N/${z#\"#DATEI \"}; : > \"$d\" ;;\n      \"#ENDE \"*) [ -n \"$v\" ] && [ \"${z#\"#ENDE \"}\" = \"$v\" ] && ok=1; d=\"\" ;;\n      *) [ -n \"$d\" ] && print -r -- \"$z\" >> \"$d\" ;;\n    esac\n  done < \"$1\"\n  [ $ok = 1 ] && [ -s $N/kopf.sh ] && [ -s $N/haupt.sh ] && [ -s $N/ende.sh ] && [ -s $N/waechter.sh ] || { rm -rf $N; return 1; }\n  rm -rf $B/skripte-alt; [ -d $S ] && mv $S $B/skripte-alt; mv $N $S; VNEU=$v; return 0; }\nVALT=$(cat $S/VERSION 2>/dev/null)\nif auspacken $B/paket-github.txt; then\n  if [ \"$VALT\" = \"$VNEU\" ]; then note \"Stempel-Skripte v$VNEU (GitHub) - waren schon aktuell\"\n  else note \"Stempel-Skripte v$VNEU von GitHub installiert${VALT:+ (vorher v$VALT)}\"; fi\nelif [ ! -f $S/kopf.sh ] && auspacken $B/paket-eingebaut.txt; then\n  note \"GitHub nicht erreichbar - eingebaute Stempel-Skripte v$VNEU installiert\"\nelse\n  note \"Update fehlgeschlagen (GitHub nicht erreichbar oder Paket unvollstaendig)${VALT:+ - es bleibt v$VALT}\"\nfi\n[ -s $B/orte.txt ] || note \"Ortsliste fehlt - bitte die private Fassung von Stempeln Update starten (aus Google Drive)\"\nrm -f $B/paket-github.txt $B/paket-eingebaut.txt\n","timeoutSeconds":90,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-8664986597062009673,"m_classType":"ShellScriptAction","m_comment":"Paket pruefen und installieren (sonst eingebaute Fassung beim ersten Mal); Ortsliste schreiben","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_category":"Uncategorized","m_completed":true,"m_constraintList":[],"m_description":"Stempeln Update v4 (2.11.2026) - holt die neuesten Stempel-Skripte von GitHub. NUR STARTEN, WENN CLAUDE ES SAGT (oder du es willst).\nSO LAEUFT ES: laedt das Skript-Paket, prueft es auf Vollstaendigkeit und installiert es in Download/stempeln/skripte; die alte Fassung bleibt als skripte-alt. Meldung \"Stempel-Skripte vX installiert\". Ist GitHub nicht erreichbar, bleibt alles wie es ist (beim allerersten Mal: eingebaute Fassung). Die private Fassung (Google Drive) schreibt ausserdem deine Ortsliste (Download/stempeln/orte.txt).\nDU MUSST: von Hand starten, Internet an. Nach dem ersten Import EINMAL starten.","m_descriptionOpen":false,"m_enabled":true,"m_excludeLog":false,"m_headingColor":0,"m_isOrCondition":false,"m_name":"Stempeln Update v4","m_triggerList":[{"disableLogging":false,"m_SIGUID":8051553238808380415,"m_classType":"EmptyTrigger","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}]},"macroExportVersion":1}