e":"","m_extra4Type":0,"m_extra4Value":"","m_extra5Name":"","m_extra5Type":0,"m_extra5Value":"","m_extra6Name":"","m_extra6Type":0,"m_extra6Value":"","m_flags":0,"m_mimeType":"","m_packageName":"com.android.chrome","m_target":"Activity","useCustomCategory":false,"disableLogging":false,"m_SIGUID":-2147769704301108476,"m_classType":"SendIntentAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Stempelseite in Chrome; application_id -> Chrome nimmt jedes Mal denselben Tab"},{"m_delayInMilliSeconds":0,"m_delayInSeconds":6,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-3038843731126567523,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":3768162034236490184,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v2.3 | 3 Vordergrund: {fg_app_name}","m_comment":""},{"disableLogging":false,"m_SIGUID":-3713538166964102133,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v2.3 | 4 Ort bestimmen und passenden Knopf tippen (Shizuku)","m_comment":""},{"blockNextAction":true,"m_nonRoot":false,"m_script":"B=/sdcard/Download/stempeln\nD=$(cat $B/aktuell.txt 2>/dev/null); [ -d \"$D\" ] || { D=$B/ohne-start; mkdir -p \"$D\"; }\nL=$D/log.txt\nK=$D/kurz.txt\nDEBUG=1\nexec 2>>\"$L\"\nt() { echo \"$(date +%T) $*\" >> \"$L\"; }\nnote() { cmd notification post -S bigtext -t \"Stempeln\" stempeln \"$1\" </dev/null >/dev/null 2>&1; }\nvorne() { dumpsys activity activities </dev/null 2>&1 | grep -m1 -E 'topResumedActivity|mResumedActivity' | tr -s ' ' | cut -c1-160; }\nLAT=\"{last_loc_lat}\"\nLON=\"{last_loc_long}\"\nORTE=\"\"\nmikro() { g=${1%%.*}; f=${1#*.}; [ \"$f\" = \"$1\" ] && f=0; f=${f}000000; f=${f%\"${f#??????}\"}; echo $(( g*1000000 + 1$f - 1000000 )); }\nwurzel() { n=$1; x=$n; [ $x -le 1 ] && { echo $x; return; }; y=$(( (x+1)/2 )); while [ $y -lt $x ]; do x=$y; y=$(( (x + n/x)/2 )); done; echo $x; }\nabst() { a=$(( $1 - $3 )); b=$(( $2 - $4 )); [ $a -lt 0 ] && a=$(( -a )); [ $b -lt 0 ] && b=$(( -b ))\n  if [ $a -gt 200000 ] || [ $b -gt 200000 ]; then echo 99999; return; fi\n  a=$(( a*1112/10000 )); b=$(( b*766/10000 )); wurzel $(( a*a + b*b )); }\nt \"Schritt 4: Ort bestimmen\"\nt \"MacroDroid-Standort: lat=$LAT lon=$LON\"\nt \"Android-Standort: $(dumpsys location </dev/null 2>&1 | grep -m3 -iE 'last location=|Location\\[fused' | tr -s ' ' | cut -c1-220 | tr '\\n' ' ')\"\nt \"Vorne: $(vorne)\"\nif [ $DEBUG = 1 ]; then screencap -p \"$D/1-vor-tipp.png\" </dev/null >/dev/null 2>&1; t \"Screenshot 1-vor-tipp rc=$?\"; fi\necho \"Standort: $LAT, $LON\" > \"$K\"\nTYP=\"\"; DIST=\"\"; RAD=\"\"; NAME=\"\"\ncase \"$LAT$LON\" in\n  *[0-9].[0-9]*[0-9].[0-9]*)\n    MLA=$(mikro \"$LAT\"); MLO=$(mikro \"$LON\")\n    t \"Mikrograd: $MLA $MLO\"\n    set -f; ALT=$IFS; IFS='|'\n    for O in $ORTE; do\n      IFS=';'; set -- $O; IFS='|'\n      [ $# -ge 4 ] || continue\n      R=${5:-800}\n      E=$(abst $MLA $MLO $(mikro \"$2\") $(mikro \"$3\"))\n      t \"Ort $1 $4: $E m (Radius $R)\"\n      if [ \"$E\" = 99999 ]; then echo \"$4: ueber 20 km\" >> \"$K\"; else echo \"$4: $E m\" >> \"$K\"; fi\n      if [ -z \"$DIST\" ] || [ \"$E\" -lt \"$DIST\" ]; then TYP=$1; DIST=$E; RAD=$R; NAME=$4; fi\n    done\n    IFS=$ALT; set +f ;;\n  *) t \"Standort ungueltig: '$LAT' '$LON'\" ;;\nesac\nt \"Naechster: typ=$TYP name=$NAME dist=$DIST radius=$RAD\"\ncase \"$TYP\" in\n  HO)  X=113; Y=436; KNOPF=\"HOME OFFICE\" ;;\n  SS)  X=70;  Y=567; KNOPF=\"SUR SITE\" ;;\n  HUB) X=172; Y=567; KNOPF=\"HUB\" ;;\n  *)   X=\"\"; KNOPF=\"\" ;;\nesac\nif [ -z \"$TYP\" ] && [ -z \"$DIST\" ]; then\n  ERGT=\"Kein Standort ('$LAT') - nichts gestempelt\"\nelif [ -z \"$X\" ]; then\n  ERGT=\"Ort nicht berechnet (Typ '$TYP') - nichts gestempelt\"\nelif [ \"$DIST\" -gt \"$RAD\" ]; then\n  ERGT=\"Kein bekannter Ort (naechster: $NAME, $DIST m, Radius $RAD m) - nichts gestempelt\"\nelse\n  t \"Tippe $KNOPF bei $X,$Y ($NAME, $DIST m, Radius $RAD m)\"\n  input tap $X $Y </dev/null >/dev/null 2>&1\n  RC=$?\n  t \"Tipp rc=$RC\"\n  ERGT=\"$KNOPF gedrueckt ($NAME, $DIST m, rc=$RC)\"\n  sleep 2\n  if [ $DEBUG = 1 ]; then screencap -p \"$D/2-nach-tipp.png\" </dev/null >/dev/null 2>&1; t \"Screenshot 2-nach-tipp rc=$?\"; fi\nfi\nt \"Ergebnis: $ERGT\"\necho \"$ERGT\" > \"$D/ergebnis.txt\"\necho \"$(date) $ERGT [${D##*/}]\" >> /sdcard/Download/stempeln.txt\nnote \"$ERGT - Seite wird neu geladen\"","timeoutSeconds":45,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-9170161079148919808,"m_classType":"ShellScriptAction","m_comment":"Naechsten Ort bestimmen (Liste ORTE: Typ;Lat;Lon;Name;Radius|...; Rechnung ohne awk), Knopf per Shizuku tippen; Log + Screenshots im Lauf-Ordner (DEBUG=1)","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":7005767066593438150,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v2.3 | 5 warte 5 s","m_comment":""},{"m_delayInMilliSeconds":0,"m_delayInSeconds":5,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-7234447682254213043,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":8281796166114787869,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v2.3 | 6 Seite neu laden (gleicher Tab)","m_comment":""},{"EXTRA_TYPE_AUTO":0,"EXTRA_TYPE_BOOLEAN":2,"EXTRA_TYPE_DOUBLE":6,"EXTRA_TYPE_FLOAT":5,"EXTRA_TYPE_INT":3,"EXTRA_TYPE_LONG":4,"EXTRA_TYPE_STRING":1,"EXTRA_TYPE_STRING_ARRAY":7,"EXTRA_TYPE_URI":8,"additionalExtras":[],"m_actio