ng\" </dev/null >/dev/null 2>&1; t \"Screenshot 3-nach-neuladen rc=$?\"; fi\nERGT=$(cat \"$D/ergebnis.txt\" 2>/dev/null || echo \"kein Ergebnis - Schritt 4 lief nicht\")\nFEHL=$(grep -v '^[0-9][0-9]:[0-9][0-9]:[0-9][0-9] ' \"$L\" 2>/dev/null | tail -n 3)\nnote \"$ERGT\n$(cat \"$K\" 2>/dev/null)\n${FEHL:+Fehler: $FEHL\n}Log: Download/stempeln/${D##*/} (v2.3)\"\nt \"Ende\"","timeoutSeconds":30,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":4326588557402173640,"m_classType":"ShellScriptAction","m_comment":"Screenshot nach Neuladen; Benachrichtigung mit Ergebnis, Entfernungen und Fehlern","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":6486815027625322210,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v2.3 | 7 Startbildschirm, Chrome beenden","m_comment":""},{"disableLogging":false,"m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_classType":"LaunchHomeScreenAction","m_SIGUID":6924126633663011319},{"m_delayInMilliSeconds":0,"m_delayInSeconds":1,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-2259483003969802121,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_classType":"KillBackgroundAppAction","m_applicationNameList":["Chrome"],"m_packageNameList":["com.android.chrome"],"m_SIGUID":3318647698186501763},{"disableLogging":false,"m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"cancelPrevious":true,"m_backgroundColor":-14606047,"m_displayIcon":false,"m_duration":2,"m_horizontalPosition":0,"m_imageName":"launcher_no_border","m_imagePackageName":"com.arlosoft.macrodroid","m_imageResourceName":"launcher_no_border","m_messageText":"Stempeln fertig – Ergebnis in der Benachrichtigung (keine Benachrichtigung = Shizuku lief nicht)","m_position":0,"m_textColor":-1,"m_tintIcon":false,"maintainSpaces":false,"textAlignment":0,"useTextOnly":true,"m_comment":"","m_classType":"ToastAction","m_SIGUID":4830989862729628935},{"disableLogging":false,"m_SIGUID":-763809066466175143,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v2.3 | 8 Ende","m_comment":""}],"m_category":"Uncategorized","m_completed":true,"m_constraintList":[],"m_description":"Stempeln Ort v2.3 (27.10.2026; v2.3: Entfernung per Shell-Ganzzahl statt awk - awk lieferte am Pixel nichts; Benachrichtigung zeigt Ergebnis, Entfernung zu jedem Ort und Fehlermeldungen; v2.2: Diagnose in Download/stempeln/<Zeit>/ (log.txt, Screenshots 1-vor-tipp/2-nach-tipp/3-nach-neuladen, DEBUG=1); Pixel 8): STEMPELT. Standort holen, Stempelseite in Chrome oeffnen, per Shizuku-Shell den naechsten Ort aus der Liste ORTE (Typ;Lat;Lon;Name;Radius|..., Typ HO/SS/HUB, Radius leer = 800 m) bestimmen und den passenden Knopf tippen: HO=113,436 (Entree/Sortie Home Office), SS=70,567 (Sur Site), HUB=172,567. Sonst nichts tippen.","m_descriptionOpen":false,"m_enabled":true,"m_excludeLog":false,"m_headingColor":0,"m_isOrCondition":false,"m_name":"Stempeln Ort v2.3","m_triggerList":[{"disableLogging":false,"m_SIGUID":8868231905532059378,"m_classType":"EmptyTrigger","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}]},"macroExportVersion":1}