e},"m_comment":""},{"disableLogging":false,"m_SIGUID":9038063913941014720,"m_classType":"EndIfAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_category":"Uncategorized","m_completed":true,"m_constraintList":[],"m_description":"Stempel-Waechter v3.4 (29.10.2026) - erinnert dich ans Stempeln. Laeuft von selbst.\nSO LAEUFT ES: Mo-Fr 06:30-19:30 alle 5 min Standort und gemerkter Stand. Erinnerung \"Stempeln?\" mit Uhrzeit, Grund und Knopf+Ort, z. B. \"12:00 - Mittagspause - ausstempeln? -> SUR SITE (Le Brassus)\": Di/Fr ab 7:30 zu Hause, Mo/Mi/Do ab 8:15 noch zu Hause (Home Office?), Ankunft im Buero, Mittagspause ab 11:45, Pause 35 min vorbei, 8 h 25 voll, Buero verlassen. Wiederholung alle 15 min.\nDU MUSST: in der Erinnerung [Stempeln] oder [Spaeter (15 min)] tippen. Wenn um 06:30 \"Shizuku laeuft nicht\" kommt: Shizuku starten.\nDU MUSST NICHT: das Makro starten oder ausschalten. Still bleibt es am Wochenende, an Waadtlaender Feiertagen, an freien Tagen (Stempeln Frei) und nach Feierabend.","m_descriptionOpen":false,"m_enabled":true,"m_excludeLog":false,"m_headingColor":0,"m_isOrCondition":false,"m_name":"Stempel-Waechter v3.4","m_triggerList":[{"m_ignoreReferenceStartTime":false,"m_minutes":0,"m_seconds":300,"m_startHour":0,"m_startMinute":0,"m_useAlarm":true,"disableLogging":false,"m_SIGUID":-8435121201292890135,"m_classType":"RegularIntervalTrigger","m_constraintList":[{"disableLogging":false,"m_SIGUID":1375847201558187538,"m_classType":"MacroDroidVariableConstraint","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"checkCase":false,"dictionaryKeys":{"keys":[]},"dictionaryType":0,"enableRegex":false,"m_booleanValue":true,"m_doubleValue":0.0,"m_intCompareVariable":false,"m_intGreaterThan":false,"m_intLessThan":false,"m_intNotEqual":false,"m_intValue":0,"m_stringComparisonType":0,"m_stringEqual":true,"m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVa