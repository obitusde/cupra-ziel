m_type":0,"supportsInput":true,"supportsOutput":true},"m_comment":""},{"disableLogging":false,"m_SIGUID":5239731631931311193,"m_classType":"EndIfAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":1475974855919065206,"m_classType":"IfConditionAction","m_constraintList":[{"m_not":false,"m_siGuidThatInvoked":-8435121201292890135,"m_triggerName":"alle 5 min","disableLogging":false,"m_SIGUID":-3326805977444695614,"m_classType":"TriggerThatInvokedConstraint","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_isDisabled":false,"m_isOrCondition":false,"childrenCollapsed":false,"dontLogIfConditionIsFalse":false,"m_comment":"alle 5 min: Standort holen, Skript entscheidet"},{"disableLogging":false,"m_SIGUID":7766216992255589691,"m_classType":"ForceLocationUpdateAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Aktuellen Standort holen -> {last_loc_lat}/{last_loc_long}"},{"m_delayInMilliSeconds":0,"m_delayInSeconds":8,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":6613773683910206069,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":false,"m_script":"B=/sdcard/Download/stempeln\nmkdir -p $B\nDEBUG=0\nSOLL=505\nORTE=\"\"\n# Meldung mit Uhrzeit vorne: note TEXT TITEL TAG\nnote() { cmd notification post -S bigtext -t \"$2\" \"$3\" \"$(date +%H:%M) · $1\" </dev/null >/dev/null 2>&1; }\n# Vorschlag an den Waechter: Text steht im Titel (MacroDroid zeigt {not_title}), Kennung \"Stempel-Vorschlag\" im Text\nsignal() { cmd notification post -S bigtext -t \"$(date +%H:%M) · $1\" vorschlag \"Stempel-Vorschlag\" </dev/null >/dev/null 2>&1; }\njetzt() { if [ -n \"$T_JETZT\" ]; then set -- $T_JETZT; else set -- $(date '+%Y %m %d %H %M %u %s'); fi\n  JJ=$1; MM=${2#0}; TT=${3#0}; HH=${4#0}; MI=${5#0}; WT=$6; EPOCH=$7; HEUTE=$1-$2-$3; NOW=$(( ${HH:-0}*60 + ${MI:-0} )); }\nhm() { echo \"$(( $1 / 60 )):$(( $1 % 60 / 10 ))$(( $1 % 10 ))\"; }\nminuten() { h=${1%%:*}; m=${1#*:}; h=${h#0}; m=${m#0}; echo $(( ${h:-0}*60 + ${m:-0} )); }\nmikro() { g=${1%%.*}; f=${1#*.}; [ \"$f\" = \"$1\" ] && f=0; f=${f}000000; f=${f%\"${f#??????}\"}; echo $(( g*1000000 + 1$f - 1000000 )); }\nwurzel() { n=$1; x=$n; [ $x -le 1 ] && { echo $x; return; }; y=$(( (x+1)/2 )); while [ $y -lt $x ]; do x=$y; y=$(( (x + n/x)/2 )); done; echo $x; }\nabst() { a=$(( $1 - $3 )); b=$(( $2 - $4 )); [ $a -lt 0 ] && a=$(( -a )); [ $b -lt 0 ] && b=$(( -b ))\n  if [ $a -gt 200000 ] || [ $b -gt 200000 ]; then echo 99999; return; fi\n  a=$(( a*1112/10000 )); b=$(( b*766/10000 )); wurzel $(( a*a + b*b )); }\n# naechster Ort -> TYP DIST RAD NAME (TYP leer = kein gueltiger Standort)\nort() { TYP=\"\"; DIST=\"\"; RAD=\"\"; NAME=\"\"\n  case \"$1$2\" in *[0-9].[0-9]*[0-9].[0-9]*) ;; *) return ;; esac\n  la=$(mikro \"$1\"); lo=$(mikro \"$2\")\n  set -f; alt=$IFS; IFS='|'\n  for o in $ORTE; do\n    IFS=';'; set -- $o; IFS='|'\n    [ $# -ge 4 ] || continue\n    e=$(abst $la $lo $(mikro \"$2\") $(mikro \"$3\")); r=${5:-800}\n    if [ -z \"$DIST\" ] || [ \"$e\" -lt \"$DIST\" ]; then TYP=$1; DIST=$e; RAD=$r; NAME=$4; fi\n  done\n  IFS=$alt; set +f; }\n# Knopf-Text fuer Typ $1 und Ort $2: SUR SITE mit Ortsname (zwei Bueros), HUB und HOME OFFICE ohne\nlabel() { case \"$1\" in HO) echo \"HOME OFFICE\" ;; HUB) echo \"HUB\" ;;\n  SS) n=${2%% \\(*}; echo \"SUR SITE${n:+ ($n)}\" ;; *) echo \"unbekannter Ort, du tippst selbst\" ;; esac; }\n# Welcher Knopf fuer Richtung $1 (EIN/AUS)? AUS = Knopf vom Einstempeln (Z_ORT), sonst Standort (vorher ort aufrufen)\n# -> KTYP KNAME LABEL (KTYP leer = unbekannter Ort)\nwahl() { if [ \"$1\" = AUS ] && [ -n \"$Z_ORT\" ]; then KTYP=$Z_ORT; KNAME=$Z_NAME\n  elif [ -n \"$TYP\" ] && [ \"$DIST\" -le \"$RAD\" ]; then KTYP=$TYP; KNAME=$NAME\n  else KTYP=\"\"; KNAME=\"\"; fi\n  LABEL=$(label \"$KTYP\" \"$KNAME\"); }\njetzt\nW=$B/waechter.log\nw() { [ $DEBUG = 1 ] && echo \"$(date '+%d.%m. %H:%M') $*\" >> $W; }\nexec 2>>$B/fehler.log\n# laeuft gerade Stempeln?\n[ -f $B/lock.txt ] && [ $(( EPOCH - $(cat $B/lock.txt) )) -lt 240 ] && { w \"Stempeln laeuft - nichts\"; exit 0; }\n# Arbeitstag? Mo-Fr, kein Waadtlaender Feiertag, nicht frei\ntagnr() { y=$1; m=$2; d=$3; [ $m -le 2 ] && y=$(( y - 1 )); era=$(( y / 400 )); yoe=$(( y - era*400 ))\n  if [ $m -gt 2 ]; then mp=$(( m - 3 )); else mp=$(( m + 9 )); fi\n  doy=$(( (153*mp + 2)/5 + d - 1 )); doe=$(( yoe*365 + yoe/4 - yoe/100 + doy )); echo $(( era*146097 + doe - 719468 )); }\nfeiertag() { y=$1; n=$2\n  a=$(( y % 19 )); b=$(( y / 100 )); c=$(( y % 100 )); d=$(( b / 4 )); e=$(( b % 4 )); f=$(( (b + 8) / 25 )); g=$(( (b - f + 1) / 3 ))\n  h=$(( (19*a + b - d - g + 15) % 30 )); i=$(( c / 4 )); k=$(( c % 4 )); l=$(( (32 + 2*e + 2*i - h - k) % 7 )); m=$(( (a + 11*h + 22*l) / 451 ))\n  om=$(( (h + l - 7*m + 114) / 31 )); od=$(( (h + l - 7*m + 114) % 31 + 1 )); os=$(tagnr $y $om $od)\n  s1=$(tagnr $y 9 1); wd=$(( (s1 + 4) % 7 )); bettag=$(( s1 + (7 - wd) % 7 + 15 ))\n  for f in $(tagnr $y 1 1) $(tagnr $y 1 2) $(( os - 2 )) $(( os + 1 )) $(( os + 39 )) $(( os + 50 )) $(tagnr $y 8 1) $bettag $(tagnr $y 12 25); do\n    [ $f = $n ] && return 0; done; return 1; }\nHN=$(tagnr $JJ $MM $TT)\nFREI=\"{v=frei_bis}\"; FN=0\ncase \"$FREI\" in *[0-9].*[0-9].*[0-9]*) fd=${FREI%%.*}; r=${FREI#*.}; fm=${r%%.*}; fy=${r#*.}; fd=${fd#0}; fm=${fm#0}; [ ${#fy} = 2 ] && fy=20$fy; FN=$(tagnr $fy $fm $fd) ;; esac\nGRUND=\"\"\n[ $WT -gt 5 ] && GRUND=\"Wochenende\"\nfeiertag $JJ $HN && GRUND=\"Feiertag\"\n[ $HN -lt $FN ] && GRUND=\"frei bis $FREI\"\nruhe() { [ \"$(cat $B/ruhe.txt 2>/dev/null)\" = \"$HEUTE\" ] && exit 0\n  echo \"$HEUTE\" > $B/ruhe.txt; w \"Ruhe: $1\"; note \"Stempel-Ruhe · $1\" \"Stempel-Ruhe\" ruhe; exit 0; }\n[ -n \"$GRUND\" ] && ruhe \"$GRUND\"\n# Stand vom letzten Stempeln\nZ_DATUM=\"\"; Z_STATUS=OUT; Z_PRES=0; Z_LESE=$EPOCH; Z_LETZTE=\"\"; Z_BUCH=0; Z_ORT=\"\"; Z_NAME=\"\"\n[ -f $B/zustand.txt ] && . $B/zustand.txt\n[ \"$Z_DATUM\" != \"$HEUTE\" ] && { Z_STATUS=OUT; Z_PRES=0; Z_LESE=$EPOCH; Z_LETZTE=\"\"; Z_BUCH=0; Z_ORT=\"\"; Z_NAME=\"\"; }\nP=$Z_PRES; [ \"$Z_STATUS\" = IN ] && P=$(( Z_PRES + (EPOCH - Z_LESE) / 60 ))\n[ \"$Z_STATUS\" = OUT ] && [ $P -ge $SOLL ] && ruhe \"Feierabend ($(hm $P))\"\n# spaeter?\n[ -f $B/spaeter.txt ] && [ $EPOCH -lt $(cat $B/spaeter.txt) ] && { w \"spaeter - nichts\"; exit 0; }\nort \"{last_loc_lat}\" \"{last_loc_long}\"\nDA=\"\"; [ -n \"$TYP\" ] && [ \"$DIST\" -le \"$RAD\" ] && DA=$TYP\nZIEL=\"\"; MSG=\"\"; GRUND=\"\"; WDH=15\nif [ \"$Z_STATUS\" = IN ]; then\n  if [ $P -ge $SOLL ]; then ZIEL=AUS; GRUND=\"8 h 25 voll\"; UE=$(( P - SOLL ))\n    MSG=\"8 h 25 voll seit $(hm $(( (NOW - UE + 1440) % 1440 )))\"; [ $UE -ge 5 ] && MSG=\"$MSG (+$UE min)\"; MSG=\"$MSG - ausstempeln?\"\n  elif [ $NOW -ge 705 ] && [ $NOW -lt 870 ] && [ $(minuten \"${Z_LETZTE:-0:00}\") -lt 660 ]; then\n    ZIEL=AUS; GRUND=\"Mittagspause\"; MSG=\"Mittagspause (heute $(hm $P)) - ausstempeln?\"\n  elif [ \"$Z_ORT\" = SS ] || [ \"$Z_ORT\" = HUB ]; then\n    if [ -n \"$TYP\" ] && { [ \"$TYP\" != SS ] && [ \"$TYP\" != HUB ] || [ \"$DIST\" -gt $(( RAD + 200 )) ]; }; then\n      ZIEL=AUS; GRUND=\"Buero verlassen\"; MSG=\"Buero verlassen (heute $(hm $P)) - ausstempeln?\"; fi\n  fi\nelif [ \"$Z_BUCH\" = 0 ]; then\n  case \"$DA\" in\n    SS|HUB) ZIEL=EIN; GRUND=\"Ankunft\"; MSG=\"Angekommen - einstempeln?\"; [ $NOW -lt 480 ] && WDH=9999 ;;\n    HO) if { [ $WT = 2 ] || [ $WT = 5 ]; } && [ $NOW -ge 450 ] && [ $NOW -lt 660 ]; then ZIEL=EIN; GRUND=\"Home Office\"; MSG=\"Zu Hause - einstempeln?\"\n        elif [ $NOW -ge 495 ] && [ $NOW -lt 660 ]; then ZIEL=EIN; GRUND=\"Home Office\"; MSG=\"Noch zu Hause - heute Home Office? Einstempeln?\"; fi ;;\n  esac\nelse\n  LZ=$(minuten \"${Z_LETZTE:-0:00}\")\n  if [ $LZ -ge 660 ] && [ $LZ -le 870 ] && [ $NOW -ge $(( LZ + 35 )) ] && [ $NOW -le $(( LZ + 180 )) ]; then\n    ZIEL=EIN; GRUND=\"Pause vorbei\"; MSG=\"Pause seit $(( NOW - LZ )) min (heute $(hm $P)) - wieder einstempeln?\"; fi\nfi\nw \"Stand=$Z_STATUS heute=$(hm $P) Ort=${TYP:-?} ${DIST:-} m da=${DA:-nein} -> ${ZIEL:-nichts}\"\n[ -z \"$ZIEL\" ] && exit 0\nwahl $ZIEL\nMSG=\"$MSG → $LABEL\"\nV_ZIEL=\"\"; V_ZEIT=0; V_DATUM=\"\"; V_LABEL=\"\"\n[ -f $B/vorschlag-letzter.txt ] && . $B/vorschlag-letzter.txt\n# gleiche Frage (Richtung und Knopf) erst nach WDH Minuten wiederholen\nif [ \"$V_ZIEL\" = \"$ZIEL\" ] && [ \"$V_LABEL\" = \"$LABEL\" ] && [ \"$V_DATUM\" = \"$HEUTE\" ] && [ $(( (EPOCH - V_ZEIT) / 60 )) -lt $WDH ]; then exit 0; fi\n{ echo \"V_ZIEL=$ZIEL\"; echo \"V_ZEIT=$EPOCH\"; echo \"V_DATUM=$HEUTE\"; echo \"V_LABEL='$LABEL'\"; echo \"V_GRUND='$GRUND'\"; } > $B/vorschlag-letzter.txt\ncp $B/vorschlag-letzter.txt $B/vorschlag.txt\nw \"Vorschlag: $MSG\"\nsignal \"$MSG\"\n","timeoutSeconds":30,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":7693715077634296154,"m_classType":"ShellScriptAction","m_comment":"Arbeitstag? (Mo-Fr, VD-Feiertage, frei_bis) Stand aus zustand.txt + Standort -> Vorschlag (Benachrichtigung \"Stempel-Vorschlag\") oder Ruhe; ab 11:45 Mittagspause-Erinnerung","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":-7648260235927256237,"m_classType":"EndIfAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":-7782985828430221199,"m_classType":"IfConditionAction","m_constraintList":[{"m_not":false,"m_siGuidThatInvoked":2553848949639059519,"m_triggerName":"Vorschlag","disableLogging":false,"m_SIGUID":5761374680219046317,"m_classType":"TriggerThatInvokedConstraint","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_isDisabled":false,"m_isOrCondition":false,"childrenCollapsed":false,"dontLogIfConditionIsFalse":false,"m_comment":"Vorschlag: Shell-Signal entfernen, Benachrichtigung mit Knoepfen"},{"enableRegex":true,"ignoreCase":true,"m_ageInSeconds":0,