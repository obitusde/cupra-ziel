eType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"shizuku_ok","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true},"m_comment":""},{"blockNextAction":true,"m_nonRoot":false,"m_script":"B=/sdcard/Download/stempeln\nmkdir -p $B\nDEBUG=0\nSOLL=505\nORTE=\"\"\nnote() { cmd notification post -S bigtext -t \"$2\" \"$3\" \"$1\" </dev/null >/dev/null 2>&1; }\njetzt() { if [ -n \"$T_JETZT\" ]; then set -- $T_JETZT; else set -- $(date '+%Y %m %d %H %M %u %s'); fi\n  JJ=$1; MM=${2#0}; TT=${3#0}; HH=${4#0}; MI=${5#0}; WT=$6; EPOCH=$7; HEUTE=$1-$2-$3; NOW=$(( ${HH:-0}*60 + ${MI:-0} )); }\nhm() { echo \"$(( $1 / 60 )):$(( $1 % 60 / 10 ))$(( $1 % 10 ))\"; }\nminuten() { h=${1%%:*}; m=${1#*:}; h=${h#0}; m=${m#0}; echo $(( ${h:-0}*60 + ${m:-0} )); }\nmikro() { g=${1%%.*}; f=${1#*.}; [ \"$f\" = \"$1\" ] && f=0; f=${f}000000; f=${f%\"${f#??????}\"}; echo $(( g*1000000 + 1$f - 1000000 )); }\nwurzel() { n=$1; x=$n; [ $x -le 1 ] && { echo $x; return; }; y=$(( (x+1)/2 )); while [ $y -lt $x ]; do x=$y; y=$(( (x + n/x)/2 )); done; echo $x; }\nabst() { a=$(( $1 - $3 )); b=$(( $2 - $4 )); [ $a -lt 0 ] && a=$(( -a )); [ $b -lt 0 ] && b=$(( -b ))\n  if [ $a -gt 200000 ] || [ $b -gt 200000 ]; then echo 99999; return; fi\n  a=$(( a*1112/10000 )); b=$(( b*766/10000 )); wurzel $(( a*a + b*b )); }\n# naechster Ort -> TYP DIST RAD NAME (TYP leer = kein gueltiger Standort)\nort() { TYP=\"\"; DIST=\"\"; RAD=\"\"; NAME=\"\"; ORTLISTE=\"\"\n  case \"$1$2\" in *[0-9].[0-9]*[0-9].[0-9]*) ;; *) return ;; esac\n  la=$(mikro \"$1\"); lo=$(mikro \"$2\")\n  set -f; alt=$IFS; IFS='|'\n  for o in $ORTE; do\n    IFS=';'; set -- $o; IFS='|'\n    [ $# -ge 4 ] || continue\n    e=$(abst $la $lo $(mikro \"$2\") $(mikro \"$3\")); r=${5:-800}\n    if [ \"$e\" = 99999 ]; then ORTLISTE=\"$ORTLISTE\n$4: ueber 20 km\"; else ORTLISTE=\"$ORTLISTE\n$4: $e m\"; fi\n    if [ -z \"$DIST\" ] || [ \"$e\" -lt \"$DIST\" ]; then TYP=$1; DIST=$e; RAD=$r; NAME=$4; fi\n  done\n  IFS=$alt; set +f; }\nnote \"Stempel-OK · Shizuku laeuft\" \"Stempel-OK\" ok\n","timeoutSeconds":15,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-906321264735015486,"m_classType":"ShellScriptAction","m_comment":"Shizuku-Pruefung: zeigt kurz Stempel-OK (Signal)","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"m_delayInMilliSeconds":0,"m_delayInSeconds":20,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-6409405214305207916,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":7461666749524450384,"m_classType":"IfConditionAction","m_constraintList":[{"disableLogging":false,"m_SIGUID":4953634165338290454,"m_classType":"MacroDroidVariableConstraint","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"checkCase":false,"dictionaryKeys":{"keys":[]},"dictionaryType":0,"enableRegex":false,"m_booleanValue":false,"m_doubleValue":0.0,"m_intCompareVariable":false,"m_intGreaterThan":false,"m_intLessThan":false,"m_intNotEqual":false,"m_intValue":0,"m_stringComparisonType":0,"m_stringEqual":true,"m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"shizuku_ok","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true}}],"m_isDisabled":false,"m_isOrCondition":false,"childrenCollapsed":false,"dontLogIfConditionIsFalse":false,"m_comment":"Signal kam nicht -> Shizuku laeuft nicht"},{"autoExpand":true,"blockNextAction":false,"dimBackground":true,"disableHtml":false,"displayOverStatusBar":false,"iconText":"","iconType":0,"liveNotification":false,"m_backgroundColor":-16777216,"m_iconBgColor":-769226,"m_imagePackageName":"com.arlosoft.macrodroid","m_imageResource