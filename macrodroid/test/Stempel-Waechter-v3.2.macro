RandomMin":0,"m_intValueDecrement":false,"m_intValueIncrement":false,"m_newBooleanValue":false,"m_newDoubleValue":0.0,"m_newIntValue":0,"m_trueLabel":"","m_userPrompt":false,"m_userPromptEmptyAtStart":false,"m_userPromptPassword":false,"m_userPromptShowCancel":false,"m_userPromptStopAfterCancel":false,"m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"stempel_aktiv","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true},"m_comment":""},{"disableLogging":false,"m_SIGUID":6056261618632541219,"m_classType":"EndIfAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":1544563131980049910,"m_classType":"IfConditionAction","m_constraintList":[{"m_not":false,"m_siGuidThatInvoked":-1842915674161676913,"m_triggerName":"alle 5 min","disableLogging":false,"m_SIGUID":4634447313527028187,"m_classType":"TriggerThatInvokedConstraint","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_isDisabled":false,"m_isOrCondition":false,"childrenCollapsed":false,"dontLogIfConditionIsFalse":false,"m_comment":"alle 5 min: Standort holen, Skript entscheidet"},{"disableLogging":false,"m_SIGUID":-299545225558974100,"m_classType":"ForceLocationUpdateAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Aktuellen Standort holen -> {last_loc_lat}/{last_loc_long}"},{"m_delayInMilliSeconds":0,"m_delayInSeconds":8,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-1062995481380333752,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":false,"m_script":"B=/sdcard/Download/stempeln\nmkdir -p $B\nDEBUG=0\nSOLL=505\nORTE=\"\"\nnote() { cmd notification post -S bigtext -t \"$2\" \"$3\" \"$1\" </dev/null >/dev/null 2>&1; }\njetzt() { if [ -n \"$T_JETZT\" ]; then set -- $T_JETZT; else set -- $(date '+%Y %m %d %H %M %u %s'); fi\n  JJ=$1; MM=${2#0}; TT=${3#0}; HH=${4#0}; MI=${5#0}; WT=$6; EPOCH=$7; HEUTE=$1-$2-$3; NOW=$(( ${HH:-0}*60 + ${MI:-0} )); }\nhm() { echo \"$(( $1 / 60 )):$(( $1 % 60 / 10 ))$(( $1 % 10 ))\"; }\nminuten() { h=${1%%:*}; m=${1#*:}; h=${h#0}; m=${m#0}; echo $(( ${h:-0}*60 + ${m:-0} )); }\nmikro() { g=${1%%.*}; f=${1#*.}; [ \"$f\" = \"$1\" ] && f=0; f=${f}000000; f=${f%\"${f#??????}\"}; echo $(( g*1000000 + 1$f - 1000000 )); }\nwurzel() { n=$1; x=$n; [ $x -le 1 ] && { echo $x; return; }; y=$(( (x+1)/2 )); while [ $y -lt $x ]; do x=$y; y=$(( (x + n/x)/2 )); done; echo $x; }\nabst() { a=$(( $1 - $3 )); b=$(( $2 - $4 )); [ $a -lt 0 ] && a=$(( -a )); [ $b -lt 0 ] && b=$(( -b ))\n  if [ $a -gt 200000 ] || [ $b -gt 200000 ]; then echo 99999; return; fi\n  a=$(( a*1112/10000 )); b=$(( b*766/10000 )); wurzel $(( a*a + b*b )); }\n# naechster Ort -> TYP DIST RAD NAME (TYP leer = kein gueltiger Standort)\nort() { TYP=\"\"; DIST=\"\"; RAD=\"\"; NAME=\"\"; ORTLISTE=\"\"\n  case \"$1$2\" in *[0-9].[0-9]*[0-9].[0-9]*) ;; *) return ;; esac\n  la=$(mikro \"$1\"); lo=$(mikro \"$2\")\n  set -f; alt=$IFS; IFS='|'\n  for o in $ORTE; do\n    IFS=';'; set -- $o; IFS='|'\n    [ $# -ge 4 ] || continue\n    e=$(abst $la $lo $(mikro \"$2\") $(mikro \"$3\")); r=${5:-800}\n    if [ \"$e\" = 99999 ]; then ORTLISTE=\"$ORTLISTE\n$4: ueber 20 km\"; else ORTLISTE=\"$ORTLISTE\n$4: $e m\"; fi\n    if [ -z \"$DIST\" ] || [ \"$e\" -lt \"$DIST\" ]; then TYP=$1; DIST=$e; RAD=$r; NAME=$4; fi\n  done\n  IFS=$alt; set +f; }\njetzt\nW=$B/waechter.log\nw() { echo \"$(date '+%d.%m. %H:%M') $*\" >> $W; }\nexec 2>>$W\n# laeuft gerade Stempeln?\n[ -f $B/lock.txt ] && [ $(( EPOCH - $(cat $B/lock.txt) )) -lt 240 ] && { w \"Stempeln laeuft - nichts\"; exit 0; }\n# Arbeitstag? Mo-Fr, kein Waadtlaender Feiertag, nicht frei\ntagnr() { y=$1; m=$2; d=$3; [ $m -le 2 ] && y=$(( y - 1 )); era=$(( y / 400 )); yoe=$(( y - era*400 ))\n  if [ $m -gt 2 ]; then mp=$(( m - 3 )); else mp=$(( m + 9 )); fi\n  doy=$(( (153*mp + 2)/5 + d - 1 )); doe=$(( yoe*365 + yoe/4 - yoe/100 + doy )); echo $(( era*146097 + doe - 719468 )); }\nfeiertag() { y=$1; n=$2\n  a=$(( y % 19 )); b=$(( y / 100 )); c=$(( y % 100 )); d=$(( b / 4 )); e=$(( b % 4 )); f=$(( (b + 8) / 25 )); g=$(( (b - f + 1) / 3 ))\n  h=$(( (19*a + b - d - g + 15) % 30 )); i=$(( c / 4 )); k=$(( c % 4 )); l=$(( (32 + 2*e + 2*i - h - k) % 7 )); m=$(( (a + 11*h + 22*l) / 451 ))\n  om=$(( (h + l - 7*m + 114) / 31 )); od=$(( (h + l - 7*m + 114) % 31 + 1 )); os=$(tagnr $y $om $od)\n  s1=$(tagnr $y 9 1); wd=$(( (s1 + 4) % 7 )); bettag=$(( s1 + (7 - wd) % 7 + 15 ))\n  for f in $(tagnr $y 1 1) $(tagnr $y 1 2) $(( os - 2 )) $(( os + 1 )) $(( os + 39 )) $(( os + 50 )) $(tagnr $y 8 1) $bettag $(tagnr $y 12 25); do\n    [ $f = $n ] && return 0; done; return 1; }\nHN=$(tagnr $JJ $MM $TT)\nFREI=\"{v=frei_bis}\"; FN=0\ncase \"$FREI\" in *[0-9].*[0-9].*[0-9]*) fd=${FREI%%.*}; r=${FREI#*.}; fm=${r%%.*}; fy=${r#*.}; fd=${fd#0}; fm=${fm#0}; [ ${#fy} = 2 ] && fy=20$fy; FN=$(tagnr $fy $fm $fd) ;; esac\nGRUND=\"\"\n[ $WT -gt 5 ] && GRUND=\"Wochenende\"\nfeiertag $JJ $HN && GRUND=\"Feiertag\"\n[ $HN -lt $FN ] && GRUND=\"frei bis $FREI\"\nruhe() { [ \"$(cat $B/ruhe.txt 2>/dev/null)\" = \"$HEUTE\" ] && exit 0\n  echo \"$HEUTE\" > $B/ruhe.txt; w \"Ruhe: $1\"; note \"Stempel-Ruhe · $1\" \"Stempel-Ruhe\" ruhe; exit 0; }\n[ -n \"$GRUND\" ] && ruhe \"$GRUND\"\n# Stand vom letzten Stempeln\nZ_DATUM=\"\"; Z_STATUS=OUT; Z_PRES=0; Z_LESE=$EPOCH; Z_LETZTE=\"\"; Z_BUCH=0; Z_ORT=\"\"\n[ -f $B/zustand.txt ] && . $B/zustand.txt\n[ \"$Z_DATUM\" != \"$HEUTE\" ] && { Z_STATUS=OUT; Z_PRES=0; Z_LESE=$EPOCH; Z_LETZTE=\"\"; Z_BUCH=0; Z_ORT=\"\"; }\nP=$Z_PRES; [ \"$Z_STATUS\" = IN ] && P=$(( Z_PRES + (EPOCH - Z_LESE) / 60 ))\n[ \"$Z_STATUS\" = OUT ] && [ $P -ge $SOLL ] && ruhe \"Feierabend ($(hm $P))\"\n# spaeter?\n[ -f $B/spaeter.txt ] && [ $EPOCH -lt $(cat $B/spaeter.txt) ] && { w \"spaeter - nichts\"; exit 0; }\nort \"{last_loc_lat}\" \"{last_loc_long}\"\nDA=\"\"; [ -n \"$TYP\" ] && [ \"$DIST\" -le \"$RAD\" ] && DA=$TYP\nZIEL=\"\"; MSG=\"\"; WDH=15\nif [ \"$Z_STATUS\" = IN ]; then\n  if [ $P -ge $SOLL ]; then ZIEL=AUS; MSG=\"8 h 25 voll (heute $(hm $P)) - ausstempeln?\"\n  elif [ $NOW -ge 705 ] && [ $NOW -lt 870 ] && [ $(minuten \"${Z_LETZTE:-0:00}\") -lt 660 ]; then\n    ZIEL=AUS; MSG=\"Mittagspause (heute $(hm $P)) - ausstempeln?\"\n  elif [ \"$Z_ORT\" = SS ] || [ \"$Z_ORT\" = HUB ]; then\n    if [ -n \"$TYP\" ] && { [ \"$TYP\" != SS ] && [ \"$TYP\" != HUB ] || [ \"$DIST\" -gt $(( RAD + 200 )) ]; }; then\n      ZIEL=AUS; MSG=\"Buero verlassen (heute $(hm $P)) - ausstempeln?\"; fi\n  fi\nelif [ \"$Z_BUCH\" = 0 ]; then\n  case \"$DA\" in\n    SS|HUB) ZIEL=EIN; MSG=\"Angekommen: $NAME - einstempeln?\"; [ $NOW -lt 480 ] && WDH=9999 ;;\n    HO) if { [ $WT = 2 ] || [ $WT = 5 ]; } && [ $NOW -ge 450 ] && [ $NOW -lt 660 ]; then ZIEL=EIN; MSG=\"Home Office - einstempeln?\"\n        elif [ $NOW -ge 495 ] && [ $NOW -lt 660 ]; then ZIEL=EIN; MSG=\"Noch zu Hause - heute Home Office? Einstempeln?\"; fi ;;\n  esac\nelse\n  LZ=$(minuten \"${Z_LETZTE:-0:00}\")\n  if [ $LZ -ge 660 ] && [ $LZ -le 870 ] && [ $NOW -ge $(( LZ + 35 )) ] && [ $NOW -le $(( LZ + 180 )) ]; then\n    ZIEL=EIN; MSG=\"Pause seit $(( NOW - LZ )) min (heute $(hm $P)) - wieder einstempeln?\"; fi\nfi\nw \"Stand=$Z_STATUS heute=$(hm $P) Ort=${TYP:-?} ${DIST:-} m da=${DA:-nein} -> ${ZIEL:-nichts}\"\n[ -z \"$ZIEL\" ] && exit 0\nV_ZIEL=\"\"; V_ZEIT=0; V_DATUM=\"\"\n[ -f $B/vorschlag-letzter.txt ] && . $B/vorschlag-letzter.txt\nif [ \"$V_ZIEL\" = \"$ZIEL\" ] && [ \"$V_DATUM\" = \"$HEUTE\" ] && [ $(( (EPOCH - V_ZEIT) / 60 )) -lt $WDH ]; then exit 0; fi\n{ echo \"V_ZIEL=$ZIEL\"; echo \"V_ZEIT=$EPOCH\"; echo \"V_DATUM=$HEUTE\"; } > $B/vorschlag-letzter.txt\ncp $B/vorschlag-letzter.txt $B/vorschlag.txt\nw \"Vorschlag: $MSG\"\nnote \"Stempel-Vorschlag · $MSG\" \"Stempel-Vorschlag\" vorschlag\n","timeoutSeconds":30,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":2018185081510390384,"m_classType":"ShellScriptAction","m_comment":"Arbeitstag? (Mo-Fr, VD-Feiertage, frei_bis) Stand aus zustand.txt + Standort -> Vorschlag (Benachrichtigung \"Stempel-Vorschlag\") oder Ruhe; ab 11:45 Mittagspause-Erinnerung","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":-2617889671378799620,"m_classType":"EndIfAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":7327882956876730785,"m_classType":"IfConditionAction","m_constraintList":[{"m_not":false,"m_siGuidThatInvoked":5734906563652809421,"m_triggerName":"Vorschlag","disableLogging":false,"m_SIGUID":4881886334520374527,"m_classType":"TriggerThatInvokedConstraint","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_isDisabled":false,"m_isOrCondition":false,"childrenCollapsed":false,"dontLogIfConditionIsFalse":false,"m_comment":"Vorschlag: Shell-Signal entfernen, Benachrichtigung mit Knoepfen"},{"enableRegex":true,"ignoreCase":true,"m_ageInSeconds":0,"m_applicationNameList":[],"m_clearPersistent":true,"m_excludes":false,"m_matchOption":2,"m_matchText":"Stempel-Vorschlag","m_option":0,"m_packageNameList":[],"disableLogging":false,"m_SIGUID":-5523347676026468565,"m_classType":"ClearNotificationsAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"autoExpand":true,"blockNextAction":false,"dimBackground":true,"disableHtml":false,"displayOverStatusBar":false,"iconText":"","iconType":0,"liveNotification":false,"m_backgroundColor":-16777216,"m_iconBgColor":-769226,"m_imagePackageName":"com.arlosoft.macrodroid","m_imageResourceId":2131231789,"m_imageResourceName":"ic_do_not_touch","m_macroGUIDToRun":0,"m_notificationChannelType":1,"m_notificationSubject":"Stempeln?","m_notificationText":"{notification}","m_overwriteExisting"