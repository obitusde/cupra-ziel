PE_URI":8,"additionalExtras":[],"m_action":"android.intent.action.VIEW","m_className":"","m_data":"https://aptime.cloud-horoquartz.fr/webquartz/ux/clock","m_extra1Name":"com.android.browser.application_id","m_extra1Type":1,"m_extra1Value":"macrodroid.stempeln","m_extra2Name":"","m_extra2Type":0,"m_extra2Value":"","m_extra3Name":"","m_extra3Type":0,"m_extra3Value":"","m_extra4Name":"","m_extra4Type":0,"m_extra4Value":"","m_extra5Name":"","m_extra5Type":0,"m_extra5Value":"","m_extra6Name":"","m_extra6Type":0,"m_extra6Value":"","m_flags":0,"m_mimeType":"","m_packageName":"com.android.chrome","m_target":"Activity","useCustomCategory":false,"disableLogging":false,"m_SIGUID":3442302843781912041,"m_classType":"SendIntentAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Stempelseite in Chrome; application_id -> Chrome nimmt jedes Mal denselben Tab"},{"m_delayInMilliSeconds":0,"m_delayInSeconds":7,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-5846496668797522246,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":1118745362412868402,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v2.2 | 2b nochmal oeffnen (erstes Oeffnen landet manchmal auf Accueil)","m_comment":""},{"EXTRA_TYPE_AUTO":0,"EXTRA_TYPE_BOOLEAN":2,"EXTRA_TYPE_DOUBLE":6,"EXTRA_TYPE_FLOAT":5,"EXTRA_TYPE_INT":3,"EXTRA_TYPE_LONG":4,"EXTRA_TYPE_STRING":1,"EXTRA_TYPE_STRING_ARRAY":7,"EXTRA_TYPE_URI":8,"additionalExtras":[],"m_action":"android.intent.action.VIEW","m_className":"","m_data":"https://aptime.cloud-horoquartz.fr/webquartz/ux/clock","m_extra1Name":"com.android.browser.application_id","m_extra1Type":1,"m_extra1Value":"macrodroid.stempeln","m_extra2Name":"","m_extra2Type":0,"m_extra2Value":"","m_extra3Name":"","m_extra3Type":0,"m_extra3Value":"","m_extra4Name":"","m_extra4Type":0,"m_extra4Value":"","m_extra5Name":"","m_extra5Type":0,"m_extra5Value":"","m_extra6Name":"","m_extra6Type":0,"m_extra6Value":"","m_flags":0,"m_mimeType":"","m_packageName":"com.android.chrome","m_target":"Activity","useCustomCategory":false,"disableLogging":false,"m_SIGUID":-4347747260534271933,"m_classType":"SendIntentAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Stempelseite in Chrome; application_id -> Chrome nimmt jedes Mal denselben Tab"},{"m_delayInMilliSeconds":0,"m_delayInSeconds":6,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-4769177297432385971,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":-8707368690241845302,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v2.2 | 3 Vordergrund: {fg_app_name}","m_comment":""},{"disableLogging":false,"m_SIGUID":512368398603418069,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v2.2 | 4 Ort bestimmen und passenden Knopf tippen (Shizuku)","m_comment":""},{"blockNextAction":true,"m_nonRoot":false,"m_script":"B=/sdcard/Download/stempeln\nD=$(cat $B/aktuell.txt 2>/dev/null); [ -d \"$D\" ] || { D=$B/ohne-start; mkdir -p \"$D\"; }\nL=$D/log.txt\nDEBUG=1\nt() { echo \"$(date +%T) $*\" >> $L; }\nnote() { cmd notification post -S bigtext -t \"Stempeln\" stempeln \"$1\" </dev/null >/dev/null 2>&1; }\nvorne() { dumpsys activity activities </dev/null 2>&1 | grep -m1 -E 'topResumedActivity|mResumedActivity' | tr -s ' ' | cut -c1-160; }\nLAT=\"{last_loc_lat}\"\nLON=\"{last_loc_long}\"\nORTE=\"\"\nt \"Schritt 4: Ort bestimmen\"\nt \"MacroDroid-Standort: lat=$LAT lon=$LON\"\nt \"Android-Standort: $(dumpsys location </dev/null 2>&1 | grep -m3 -iE 'last location=|Location\\[fused' | tr -s ' ' | cut -c1-220 | tr '\\n' ' ')\"\nt \"Vorne: $(vorne)\"\nt \"Drehung: $(dumpsys window </dev/null 2>&1 | grep -m1 -oE 'mCurrentRotation=[^ ]*|mRotation=[^ ]*')\"\nif [ $DEBUG = 1 ]; then screencap -p \"$D/1-vor-tipp.png\" </dev/null >/dev/null 2>&1; t \"Screenshot 1-vor-tipp rc=$?\"; fi\nERG=$(echo \"$ORTE\" | tr '|' '\\n' | awk -F';' -v la=\"$LAT\" -v lo=\"$LON\" '\nfunction rad(x){ return x*3.14159265358979/180 }\nNF>=4 { dl=rad($2-la); dn=rad($3-lo); a=sin(dl/2)^2+cos(rad(la))*cos(rad($2))*sin(dn/2)^2;\n        d=2*6371000*atan2(sqrt(a),sqrt(1-a)); if (best==\"\" || d<best) { best=d; typ=$1; name=$4; r=($5==\"\")?800:$5 } }\nEND { if (best==\"\") print \"KEIN;0;0;-\"; else printf \"%s;%d;%d;%s\\n\", typ, best, r, name }')\nt \"Berechnung: $ERG\"\nTYP=${ERG%%;*}; REST=${ERG#*;}; DIST=${REST%%;*}; REST=${REST#*;}; RAD=${REST%%;*}; NAME=${REST#*;}\ncase \"$TYP\" in\n  HO)  X=113; Y=436; KNOPF=\"HOME OFFICE\" ;;\n  SS)  X=70;  Y=567; KNOPF=\"SUR SITE\" ;;\n  HUB) X=172; Y=567; KNOPF=\"HUB\" ;;\n  *)   X=\"\"; KNOPF=\"\" ;;\nesac\nif [ -z \"$LAT\" ] || [ \"$LAT\" = \"0.0\" ] || [ -z \"$X\" ]; then\n  ERGT=\"Kein Standort - nichts gestempelt\"\nelif [ \"$DIST\" -gt \"$RAD\" ]; then\n  ERGT=\"Kein bekannter Ort (naechster: $NAME, $DIST m, Radius $RAD m) - nichts gestempelt\"\nelse\n  t \"Tippe $KNOPF bei $X,$Y ($NAME, $DIST m, Radius $RAD m)\"\n  input tap $X $Y </dev/null >/dev/null 2>&1\n  RC=$?\n  t \"Tipp rc=$RC\"\n  ERGT=\"$KNOPF gedrueckt ($NAME, $DIST m, rc=$RC)\"\n  sleep 2\n  if [ $DEBUG = 1 ]; then screencap -p \"$D/2-nach-tipp.png\" </dev/null >/dev/null 2>&1; t \"Screenshot 2-nach-tipp rc=$?\"; fi\nfi\nt \"Ergebnis: $ERGT\"\necho \"$ERGT\" > \"$D/ergebnis.txt\"\necho \"$(date) $ERGT [${D##*/}]\" >> /sdcard/Download/stempeln.txt\nnote \"$ERGT - Seite wird neu geladen\"","timeoutSeconds":45,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-127438532265407198,"m_classType":"ShellScriptAction","m_comment":"Naechsten Ort bestimmen (Liste ORTE: Typ;Lat;Lon;Name;Radius|...), Knopf per Shizuku tippen; Log + Screenshots 1/2 im Lauf-Ordner (DEBUG=1)","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":7264719444588768788,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v2.2 | 5 warte 5 s","m_comment":""},{"m_delayInMilliSeconds":0,"m_delayInSeconds":5,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-4334984490741068604,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":-5467278548224358104,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v2.2 | 6 Seite neu laden (gleicher Tab)","m_comment":""},{"EXTRA_TYPE_AUTO":0,"EXTRA_TYPE_BOOLEAN":2,"EXTRA_TYPE_DOUBLE":6,"EXTRA_TYPE_FLOAT":5,"EXTRA_TYPE_INT":3,"EXTRA_TYPE_LONG":4,"EXTRA_TYPE_STRING":1,"EXTRA_TYPE_STRING_ARRAY":7,"EXTRA_TYPE_URI":8,"additionalExtras":[],"m_action":"android.intent.action.VIEW","m_className":"","m_data":"https://aptime.cloud-horoquartz.fr/webquartz/ux/clock","m_extra1Name":"com.android.browser.application_id","m_extra1Type":1,"m_extra1Value":"macrodroid.stempeln","m_extra2Name":"","m_extra2Type":0,"m_extra2Value":"","m_extra3Name":"","m_extra3Type":0,"m_extra3Value":"","m_extra4Name":"","m_extra4Type":0,"m_extra4Value":"","m_extra5Name":"","m_extra5Type":0,"m_extra5Value":"","m_extra6Name":"","m_extra6Type":0,"m_extra6Value":"","m_flags":0,"m_mimeType":"","m_packageName":"com.android.chrome","m_target":"Activity","useCustomCategory":false,"disableLogging":false,"m_SIGUID":-6394051446877479265,"m_classType":"SendIntentAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Stempelseite in Chrome; application_id -> Chrome nimmt jedes Mal denselben Tab"},{"m_delayInMilliSeconds":0,"m_delayInSeconds":7,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-791534844364600542,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":9134415134719953224,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v2.2 | 6b Abschluss: Screenshot 3, Benachrichtigung","m_comment":""},{"blockNextAction":true,"m_nonRoot":false,"m_script":"B=/sdcard/Download/stempeln\nD=$(cat $B/aktuell.txt 2>/dev/null); [ -d \"$D\" ] || { D=$B/ohne-start; mkdir -p \"$D\"; }\nL=$D/log.txt\nDEBUG=1\nt() { echo \"$(date +%T) $*\" >> $L; }\nnote() { cmd notification post -S bigtext -t \"Stempeln\" stempeln \"$1\" </dev/null >/dev/null 2>&1; }\nvorne() { dumpsys activity activities </dev/null 2>&1 | grep -m1 -E 'topResumedActivity|mResumedActivity' | tr -s ' ' | cut -c1-160; }\nt \"Schritt 6: nach Neuladen\"\nt \"Vorne: $(vorne)\"\nif [ $DEBUG = 1 ]; then screencap -p \"$D/3-nach-neuladen.png\" </dev/null >/dev/null 2>&1; t \"Screenshot 3-nach-neuladen rc=$?\"; fi\nERGT=$(cat \"$D/ergebnis.txt\" 2>/dev/null || echo \"kein Ergebnis - Schritt 4 lief nicht\")\nnote \"$ERGT | Log: Download/stempeln/${D##*/}\"\nt \"Ende\"","timeoutSeconds":30,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":8946335913418387088,"m_classType":"ShellScriptAction","m_comment":"Screenshot nach Neuladen, Ergebnis + Log-Ordner als Benachrichtigung","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":-6305580342328556438,"m_classType":"LogAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"logLevel":"STANDARD","logMacro":true,"m_logText":"Stempeln Ort v2.2 | 7 Startbildschirm, Chrome beenden","m_comment":""},{"disableLogging":false,"m_constraintList":[],