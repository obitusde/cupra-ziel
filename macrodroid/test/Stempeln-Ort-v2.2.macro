00 m) bestimmen und den passenden Knopf tippen: HO=113,436 (Entree/Sortie Home Office), SS=70,567 (Sur Site), HUB=172,567. Sonst nichts tippen.","m_descriptionOpen":false,"m_enabled":true,"m_excludeLog":false,"m_headingColor":0,"m_isOrCondition":false,"m_name":"Stempeln Ort v2.2","m_triggerList":[{"disableLogging":false,"m_SIGUID":4909404391915279471,"m_classType":"EmptyTrigger","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}]},"macroExportVersion":1}