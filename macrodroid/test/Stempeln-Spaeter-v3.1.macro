{"globalVariables":[{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"seite","m_stringValue":"","m_type":4,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":true,"m_decimalValue":0.0,"m_intValue":0,"m_name":"stempel_aktiv","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"frei_bis","m_stringValue":"","m_type":2,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":true,"m_decimalValue":0.0,"m_intValue":0,"m_name":"shizuku_ok","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"seite_ok","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true}],"macro":{"aiGenerated":0,"breakpoints":[],"disabledTimestamp":0,"exportedActionBlocks":[],"exportedSharedScenes":[],"forceEvenIfNotEnabledTimestamp":0,"isActionBlock":false,"isExtra":false,"isFavourite":false,"lastEditedTimestamp":1793087286224,"localVariables":[],"localVarsAlphabetical":true,"loggingLevel":0,"m_GUID":4679729042683682275,"m_actionList":[{"blockNextAction":true,"m_nonRoot":false,"m_script":"B=/sdcard/Download/stempeln\nmkdir -p $B\nDEBUG=0\nSOLL=505\nORTE=\"\"\n# Meldung mit Uhrzeit vorne: note TEXT TITEL TAG\nnote() { cmd notification post -S bigtext -t \"$2\" \"$3\" \"$(date +%H:%M) · $1\" </dev/null >/dev/null 2>&1; }\n# Vorschlag an den Waechter: Text steht im Titel (MacroDroid zeigt {not_title}), Kennung \"Stempel-Vorschlag\" im Text\nsignal() { cmd notification post -S bigtext -t \"$(date +%H:%M) · $1\" vorschlag \"Stempel-Vorschlag\" </dev/null >/dev/null 2>&1; }\njetzt() { if [ -n \"$T_JETZT\" ]; then set -- $T_JETZT; else set -- $(date '+%Y %m %d %H %M %u %s'); fi\n  JJ=$1; MM=${2#0}; TT=${3#0}; HH=${4#0}; MI=${5#0}; WT=$6; EPOCH=$7; HEUTE=$1-$2-$3; NOW=$(( ${HH:-0}*60 + ${MI:-0} )); }\nhm() { echo \"$(( $1 / 60 )):$(( $1 % 60 / 10 ))$(( $1 % 10 ))\"; }\nminuten() { h=${1%%:*}; m=${1#*:}; h=${h#0}; m=${m#0}; echo $(( ${h:-0}*60 + ${m:-0} )); }\nmikro() { g=${1%%.*}; f=${1#*.}; [ \"$f\" = \"$1\" ] && f=0; f=${f}000000; f=${f%\"${f#??????}\"}; echo $(( g*1000000 + 1$f - 1000000 )); }\nwurzel() { n=$1; x=$n; [ $x -le 1 ] && { echo $x; return; }; y=$(( (x+1)/2 )); while [ $y -lt $x ]; do x=$y; y=$(( (x + n/x)/2 )); done; echo $x; }\nabst() { a=$(( $1 - $3 )); b=$(( $2 - $4 )); [ $a -lt 0 ] && a=$(( -a )); [ $b -lt 0 ] && b=$(( -b ))\n  if [ $a -gt 200000 ] || [ $b -gt 200000 ]; then echo 99999; return; fi\n  a=$(( a*1112/10000 )); b=$(( b*766/10000 )); wurzel $(( a*a + b*b )); }\n# naechster Ort -> TYP DIST RAD NAME (TYP leer = kein gueltiger Standort)\nort() { TYP=\"\"; DIST=\"\"; RAD=\"\"; NAME=\"\"\n  case \"$1$2\" in *[0-9].[0-9]*[0-9].[0-9]*) ;; *) return ;; esac\n  la=$(mikro \"$1\"); lo=$(mikro \"$2\")\n  set -f; alt=$IFS; IFS='|'\n  for o in $ORTE; do\n    IFS=';'; set -- $o; IFS='|'\n    [ $# -ge 4 ] || continue\n    e=$(abst $la $lo $(mikro \"$2\") $(mikro \"$3\")); r=${5:-800}\n    if [ -z \"$DIST\" ] || [ \"$e\" -lt \"$DIST\" ]; then TYP=$1; DIST=$e; RAD=$r; NAME=$4; fi\n  done\n  IFS=$alt; set +f; }\n# Knopf-Text fuer Typ $1 und Ort $2: SUR SITE mit Ortsname (zwei Bueros), HUB und HOME OFFICE ohne\nlabel() { case \"$1\" in HO) echo \"HOME OFFICE\" ;; HUB) echo \"HUB\" ;;\n  SS) n=${2%% \\(*}; echo \"SUR SITE${n:+ ($n)}\" ;; *) echo \"unbekannter Ort, du tippst selbst\" ;; esac; }\n# Welcher Knopf fuer Richtung $1 (EIN/AUS)? AUS = Knopf vom Einstempeln (Z_ORT), sonst Standort (vorher ort aufrufen)\n# -> KTYP KNAME LABEL (KTYP leer = unbekannter Ort)\nwahl() { if [ \"$1\" = AUS ] && [ -n \"$Z_ORT\" ]; then KTYP=$Z_ORT; KNAME=$Z_NAME\n  elif [ -n \"$TYP\" ] && [ \"$DIST\" -le \"$RAD\" ]; then KTYP=$TYP; KNAME=$NAME\n  else KTYP=\"\"; KNAME=\"\"; fi\n  LABEL=$(label \"$KTYP\" \"$KNAME\"); }\njetzt\nV_GRUND=\"\"; [ -f $B/vorschlag-letzter.txt ] && . $B/vorschlag-letzter.txt\necho $(( EPOCH + 900 )) > $B/spaeter.txt\nrm -f $B/vorschlag.txt\nnote \"Spaeter${V_GRUND:+: $V_GRUND} - Erinnerung wieder ab $(hm $(( (NOW + 15) % 1440 )))\" \"Stempeln\" spaeter\n","timeoutSeconds":15,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":-3312777520124525944,"m_classType":"ShellScriptAction","m_comment":"15 min Ruhe, Bestaetigung mit Grund","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"m_delayInMilliSeconds":0,"m_delayInSeconds":6,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":8628168910791698997,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"enableRegex":true,"ignoreCase":true,"m_ageInSeconds":0,"m_applicationNameList":[],"m_clearPersistent":true,"m_excludes":false,"m_matchOption":2,"m_matchText":"Erinnerung wieder ab","m_option":0,"m_packageNameList":[],"disableLogging":false,"m_SIGUID":7971170051376101575,"m_classType":"ClearNotificationsAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_category":"Uncategorized","m_completed":true,"m_constraintList":[],"m_description":"Stempeln Spaeter v3.1 (29.10.2026) - Knopf [Spaeter (15 min)] in der Erinnerung: 15 min keine Erinnerung. Kurze Bestaetigung mit Grund und Uhrzeit, verschwindet nach ein paar Sekunden von selbst. Nicht von Hand starten.","m_descriptionOpen":false,"m_enabled":true,"m_excludeLog":false,"m_headingColor":0,"m_isOrCondition":false,"m_name":"Stempeln Spaeter v3.1","m_triggerList":[{"disableLogging":false,"m_SIGUID":178560518142333759,"m_classType":"EmptyTrigger","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}]},"macroExportVersion":1}