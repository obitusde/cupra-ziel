{"globalVariables":[{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"seite","m_stringValue":"","m_type":4,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":true,"m_decimalValue":0.0,"m_intValue":0,"m_name":"stempel_aktiv","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"frei_bis","m_stringValue":"","m_type":2,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":true,"m_decimalValue":0.0,"m_intValue":0,"m_name":"shizuku_ok","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":false,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"seite_ok","m_stringValue":"","m_type":0,"supportsInput":true,"supportsOutput":true}],"macro":{"aiGenerated":0,"breakpoints":[],"disabledTimestamp":0,"exportedActionBlocks":[],"exportedSharedScenes":[],"forceEvenIfNotEnabledTimestamp":0,"isActionBlock":false,"isExtra":false,"isFavourite":false,"lastEditedTimestamp":1793087286224,"localVariables":[],"localVarsAlphabetical":true,"loggingLevel":0,"m_GUID":7067024593640181633,"m_actionList":[{"blockNextAction":true,"m_nonRoot":false,"m_script":"B=/sdcard/Download/stempeln\nmkdir -p $B\nDEBUG=0\nSOLL=505\nORTE=\"\"\n# Meldung mit Uhrzeit vorne: note TEXT TITEL TAG\nnote() { cmd notification post -S bigtext -t \"$2\" \"$3\" \"$(date +%H:%M) · $1\" </dev/null >/dev/null 2>&1; }\n# Vorschlag an den Waechter: Text steht im Titel (MacroDroid zeigt {not_title}), Kennung \"Stempel-Vorschlag\" im Text\nsignal() { cmd notification post -S bigtext -t \"$(date +%H:%M) · $1\" vorschlag \"Stempel-Vorschlag\" </dev/null >/dev/null 2>&1; }\njetzt() { if [ -n \"$T_JETZT\" ]; then set -- $T_JETZT; else set -- $(date '+%Y %m %d %H %M %u %s'); fi\n  JJ=$1; MM=${2#0}; TT=${3#0}; HH=${4#0}; MI=${5#0}; WT=$6; EPOCH=$7; HEUTE=$1-$2-$3; NOW=$(( ${HH:-0}*60 + ${MI:-0} )); }\nhm() { echo \"$(( $1 / 60 )):$(( $1 % 60 / 10 ))$(( $1 % 10 ))\"; }\nminuten() { h=${1%%:*}; m=${1#*:}; h=${h#0}; m=${m#0}; echo $(( ${h:-0}*60 + ${m:-0} )); }\nmikro() { g=${1%%.*}; f=${1#*.}; [ \"$f\" = \"$1\" ] && f=0; f=${f}000000; f=${f%\"${f#??????}\"}; echo $(( g*1000000 + 1$f - 1000000 )); }\nwurzel() { n=$1; x=$n; [ $x -le 1 ] && { echo $x; return; }; y=$(( (x+1)/2 )); while [ $y -lt $x ]; do x=$y; y=$(( (x + n/x)/2 )); done; echo $x; }\nabst() { a=$(( $1 - $3 )); b=$(( $2 - $4 )); [ $a -lt 0 ] && a=$(( -a )); [ $b -lt 0 ] && b=$(( -b ))\n  if [ $a -gt 200000 ] || [ $b -gt 200000 ]; then echo 99999; return; fi\n  a=$(( a*1112/10000 )); b=$(( b*766/10000 )); wurzel $(( a*a + b*b )); }\n# naechster Ort -> TYP DIST RAD NAME (TYP leer = kein gueltiger Standort)\nort() { TYP=\"\"; DIST=\"\"; RAD=\"\"; NAME=\"\"\n  case \"$1$2\" in *[0-9].[0-9]*[0-9].[0-9]*) ;; *) return ;; esac\n  la=$(mikro \"$1\"); lo=$(mikro \"$2\")\n  set -f; alt=$IFS; IFS='|'\n  for o in $ORTE; do\n    IFS=';'; set -- $o; IFS='|'\n    [ $# -ge 4 ] || continue\n    e=$(abst $la $lo $(mikro \"$2\") $(mikro \"$3\")); r=${5:-800}\n    if [ -z \"$DIST\" ] || [ \"$e\" -lt \"$DIST\" ]; then TYP=$1; DIST=$e; RAD=$r; NAME=$4; fi\n  done\n  IFS=$alt; set +f; }\n# Knopf-Text fuer Typ $1 und Ort $2: SUR SITE mit Ortsname (zwei Bueros), HUB und HOME OFFICE ohne\nlabel() { case \"$1\" in HO) echo \"HOME OFFICE\" ;; HUB) echo \"HUB\" ;;\n  SS) n=${2%% \\(*}; echo \"SUR SITE${n:+ ($n)}\" ;; *) echo \"unbekannter Ort, du tippst selbst\" ;; esac; }\n# Welcher Knopf fuer Richtung $1 (EIN/AUS)? AUS = Knopf vom Einstempeln (Z_ORT), sonst Standort (vorher ort aufrufen)\n# -> KTYP KNAME LABEL (KTYP leer = unbekannter Ort)\nwahl() { if [ \"$1\" = AUS ] && [ -n \"$Z_ORT\" ]; then KTYP=$Z_ORT; KNAME=$Z_NAME\n  elif [ -n \"$TYP\" ] && [ \"$DIST\" -le \"$RAD\" ]; then KTYP=$TYP; KNAME=$NAME\n  else KTYP=\"\"; KNAME=\"\"; fi\n  LABEL=$(label \"$KTYP\" \"$KNAME\"); }\njetzt\necho $EPOCH > $B/lock.txt\nD=$B/lauf; rm -rf \"$D\"; mkdir -p \"$D\"; echo \"$D\" > $B/aktuell.txt\nL=$D/log.txt; exec 2>>\"$L\"\nt() { [ $DEBUG = 1 ] && echo \"$(date +%T) $*\" >> \"$L\"; }\nt \"Stand lesen v3.3 - Start\"\ngesperrt() { dumpsys window </dev/null 2>&1 | grep -cE 'isKeyguardShowing=true|mShowingLockscreen=true|mDreamingLockscreen=true'; }\nn=0\nwhile [ \"$(gesperrt)\" != 0 ] && [ $n -lt 60 ]; do\n  [ $n = 0 ] && note \"Bitte entsperren - dann geht es weiter\" \"Stempeln\" stempeln\n  sleep 1; n=$(( n + 1 ))\ndone\ncmd statusbar collapse </dev/null >/dev/null 2>&1\nt \"entsperrt nach $n s, Leiste zu\"\nnote \"Stand lesen ...\" \"Stempeln\" stempeln\n","timeoutSeconds":75,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":1290731225395257579,"m_classType":"ShellScriptAction","m_comment":"Wartet bis 60 s aufs Entsperren, schliesst die Benachrichtigungsleiste","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":1756696218981937297,"m_classType":"ForceLocationUpdateAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Aktuellen Standort holen -> {last_loc_lat}/{last_loc_long}"},{"EXTRA_TYPE_AUTO":0,"EXTRA_TYPE_BOOLEAN":2,"EXTRA_TYPE_DOUBLE":6,"EXTRA_TYPE_FLOAT":5,"EXTRA_TYPE_INT":3,"EXTRA_TYPE_LONG":4,"EXTRA_TYPE_STRING":1,"EXTRA_TYPE_STRING_ARRAY":7,"EXTRA_TYPE_URI":8,"additionalExtras":[],"m_action":"android.intent.action.VIEW","m_className":"","m_data":"https://aptime.cloud-horoquartz.fr/webquartz/ux/clock","m_extra1Name":"com.android.browser.application_id","m_extra1Type":1,"m_extra1Value":"macrodroid.stempeln","m_extra2Name":"","m_extra2Type":0,"m_extra2Value":"","m_extra3Name":"","m_extra3Type":0,"m_extra3Value":"","m_extra4Name":"","m_extra4Type":0,"m_extra4Value":"","m_extra5Name":"","m_extra5Type":0,"m_extra5Value":"","m_extra6Name":"","m_extra6Type":0,"m_extra6Value":"","m_flags":0,"m_mimeType":"","m_packageName":"com.android.chrome","m_target":"Activity","useCustomCategory":false,"disableLogging":false,"m_SIGUID":450363829749499675,"m_classType":"SendIntentAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Stempelseite in Chrome; application_id -> Chrome nimmt jedes Mal denselben Tab"},{"m_delayInMilliSeconds":0,"m_delayInSeconds":6,"m_useAlarm":true,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-6964885345553332036,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"booleanVariableName":"seite_ok","enableRegex":false,"forceScreenRefresh":true,"ignoreCase":true,"ignoreHiddenText":true,"includeOverlays":false,"matchOption":1,"textToCheck":"HOME OFFICE","disableLogging":false,"m_SIGUID":-5757241362421779564,"m_classType":"CheckTextOnScreenAction","m_comment":"Stempelseite da? (Knopf HOME OFFICE sichtbar)","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":-625617910114592389,"m_classType":"IfConditionAction","m_constraintList":[{"disableLogging":false,"m_SIGUID":2681189988388971771,"m_classType":"MacroDroidVariableConstraint","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"checkCase":false,"dictionaryKeys":{"keys":[]},"dictionaryType":0,"enableRegex":false,"m_booleanValue":false,"m_doubleValue":0.0,"m_intCompareVariable":false,"m_intGr