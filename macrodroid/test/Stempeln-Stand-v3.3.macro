eturn; fi\n  a=$(( a*1112/10000 )); b=$(( b*766/10000 )); wurzel $(( a*a + b*b )); }\n# naechster Ort -> TYP DIST RAD NAME (TYP leer = kein gueltiger Standort)\nort() { TYP=\"\"; DIST=\"\"; RAD=\"\"; NAME=\"\"\n  case \"$1$2\" in *[0-9].[0-9]*[0-9].[0-9]*) ;; *) return ;; esac\n  la=$(mikro \"$1\"); lo=$(mikro \"$2\")\n  set -f; alt=$IFS; IFS='|'\n  for o in $ORTE; do\n    IFS=';'; set -- $o; IFS='|'\n    [ $# -ge 4 ] || continue\n    e=$(abst $la $lo $(mikro \"$2\") $(mikro \"$3\")); r=${5:-800}\n    if [ -z \"$DIST\" ] || [ \"$e\" -lt \"$DIST\" ]; then TYP=$1; DIST=$e; RAD=$r; NAME=$4; fi\n  done\n  IFS=$alt; set +f; }\n# Knopf-Text fuer Typ $1 und Ort $2: SUR SITE mit Ortsname (zwei Bueros), HUB und HOME OFFICE ohne\nlabel() { case \"$1\" in HO) echo \"HOME OFFICE\" ;; HUB) echo \"HUB\" ;;\n  SS) n=${2%% \\(*}; echo \"SUR SITE${n:+ ($n)}\" ;; *) echo \"unbekannter Ort, du tippst selbst\" ;; esac; }\n# Welcher Knopf fuer Richtung $1 (EIN/AUS)? AUS = Knopf vom Einstempeln (Z_ORT), sonst Standort (vorher ort aufrufen)\n# -> KTYP KNAME LABEL (KTYP leer = unbekannter Ort)\nwahl() { if [ \"$1\" = AUS ] && [ -n \"$Z_ORT\" ]; then KTYP=$Z_ORT; KNAME=$Z_NAME\n  elif [ -n \"$TYP\" ] && [ \"$DIST\" -le \"$RAD\" ]; then KTYP=$TYP; KNAME=$NAME\n  else KTYP=\"\"; KNAME=\"\"; fi\n  LABEL=$(label \"$KTYP\" \"$KNAME\"); }\n# Stempelseite nicht erkannt (Accueil oder noch am Laden): nochmal oeffnen, 7 s warten\nD=$(cat $B/aktuell.txt 2>/dev/null); [ -d \"$D\" ] || { D=$B/lauf; mkdir -p \"$D\"; }\nL=$D/log.txt; exec 2>>\"$L\"\nam start -a android.intent.action.VIEW -d \"https://aptime.cloud-horoquartz.fr/webquartz/ux/clock\" -p com.android.chrome --es com.android.browser.application_id macrodroid.stempeln </dev/null >/dev/null 2>&1\nsleep 7\n","timeoutSeconds":20,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":6152018567956197945,"m_classType":"ShellScriptAction","m_comment":"Stempelseite nochmal oeffnen, 7 s warten","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":2821488078557470503,"m_classType":"EndIfAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"dictionaryKeys":{"keys":[]},"forceScreenRefresh":true,"includeOverlays":false,"includeScreenLocation":true,"includeWithoutText":false,"isLocalVar":false,"variableName":"seite","disableLogging":false,"m_SIGUID":2746447113198002982,"m_classType":"ReadScreenContentsAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_comment":"Stempelseite lesen -> Woerterbuch seite (Text + Position)"},{"blockNextAction":true,"m_nonRoot":false,"m_script":"B=/sdcard/Download/stempeln\nmkdir -p $B\nDEBUG=0\nSOLL=505\nORTE=\"\"\n# Meldung mit Uhrzeit vorne: note TEXT TITEL TAG\nnote() { cmd notification post -S bigtext -t \"$2\" \"$3\" \"$(date +%H:%M) · $1\" </dev/null >/dev/null 2>&1; }\n# Vorschlag an den Waechter: Text steht im Titel (MacroDroid zeigt {not_title}), Kennung \"Stempel-Vorschlag\" im Text\nsignal() { cmd notification post -S bigtext -t \"$(date +%H:%M) · $1\" vorschlag \"Stempel-Vorschlag\" </dev/null >/dev/null 2>&1; }\njetzt() { if [ -n \"$T_JETZT\" ]; then set -- $T_JETZT; else set -- $(date '+%Y %m %d %H %M %u %s'); fi\n  JJ=$1; MM=${2#0}; TT=${3#0}; HH=${4#0}; MI=${5#0}; WT=$6; EPOCH=$7; HEUTE=$1-$2-$3; NOW=$(( ${HH:-0}*60 + ${MI:-0} )); }\nhm() { echo \"$(( $1 / 60 )):$(( $1 % 60 / 10 ))$(( $1 % 10 ))\"; }\nminuten() { h=${1%%:*}; m=${1#*:}; h=${h#0}; m=${m#0}; echo $(( ${h:-0}*60 + ${m:-0} )); }\nmikro() { g=${1%%.*}; f=${1#*.}; [ \"$f\" = \"$1\" ] && f=0; f=${f}000000; f=${f%\"${f#??????}\"}; echo $(( g*1000000 + 1$f - 1000000 )); }\nwurzel() { n=$1; x=$n; [ $x -le 1 ] && { echo $x; return; }; y=$(( (x+1)/2 )); while [ $y -lt $x ]; do x=$y; y=$(( (x + n/x)/2 )); done; echo $x; }\nabst() { a=$(( $1 - $3 )); b=$(( $2 - $4 )); [ $a -lt 0 ] && a=$(( -a )); [ $b -lt 0 ] && b=$(( -b ))\n  if [ $a -gt 200000 ] || [ $b -gt 200000 ]; then echo 99999; return; fi\n  a=$(( a*1112/10000 )); b=$(( b*766/10000 )); wurzel $(( a*a + b*b )); }\n# naechster Ort -> TYP DIST RAD NAME (TYP leer = kein gueltiger Standort)\nort() { TYP=\"\"; DIST=\"\"; RAD=\"\"; NAME=\"\"\n  case \"$1$2\" in *[0-9].[0-9]*[0-9].[0-9]*) ;; *) return ;; esac\n  la=$(mikro \"$1\"); lo=$(mikro \"$2\")\n  set -f; alt=$IFS; IFS='|'\n  for o in $ORTE; do\n    IFS=';'; set -- $o; IFS='|'\n    [ $# -ge 4 ] || continue\n    e=$(abst $la $lo $(mikro \"$2\") $(mikro \"$3\")); r=${5:-800}\n    if [ -z \"$DIST\" ] || [ \"$e\" -lt \"$DIST\" ]; then TYP=$1; DIST=$e; RAD=$r; NAME=$4; fi\n  done\n  IFS=$alt; set +f; }\n# Knopf-Text fuer Typ $1 und Ort $2: SUR SITE mit Ortsname (zwei Bueros), HUB und HOME OFFICE ohne\nlabel() { case \"$1\" in HO) echo \"HOME OFFICE\" ;; HUB) echo \"HUB\" ;;\n  SS) n=${2%% \\(*}; echo \"SUR SITE${n:+ ($n)}\" ;; *) echo \"unbekannter Ort, du tippst selbst\" ;; esac; }\n# Welcher Knopf fuer Richtung $1 (EIN/AUS)? AUS = Knopf vom Einstempeln (Z_ORT), sonst Standort (vorher ort aufrufen)\n# -> KTYP KNAME LABEL (KTYP leer = unbekannter Ort)\nwahl() { if [ \"$1\" = AUS ] && [ -n \"$Z_ORT\" ]; then KTYP=$Z_ORT; KNAME=$Z_NAME\n  elif [ -n \"$TYP\" ] && [ \"$DIST\" -le \"$RAD\" ]; then KTYP=$TYP; KNAME=$NAME\n  else KTYP=\"\"; KNAME=\"\"; fi\n  LABEL=$(label \"$KTYP\" \"$KNAME\"); }\n# Wörterbuch aus \"Bildschirminhalt lesen\" -> Zeilen \"x|y|Text\"\nelemente() { x=\"\"; y=\"\"\n  while IFS= read -r z; do\n    case \"$z\" in\n      \"-- [centerX]: \"*) x=${z#*: } ;;\n      \"-- [centerY]: \"*) y=${z#*: } ;;\n      \"-- [text]: \"*) s=${z#*\\]: }; [ -n \"$s\" ] && echo \"$x|$y|$s\" ;;\n    esac\n  done < \"$1\"; }\n# Stand aus Elementliste $1: STATUS (IN/OUT/?), PRES (Minuten, leer = nicht gelesen), LETZTE, BUCH, Knopf-Positionen\nstand() { STATUS=\"?\"; HOT=\"\"; PRES=\"\"; HOX=113; HOY=436; SSX=70; SSY=567; HUX=172; HUY=567; ZEITEN=\"\"\n  while IFS='|' read -r x y s; do\n    case \"$x$y\" in *[!0-9]*|\"\") continue ;; esac\n    if [ \"$x\" -lt 600 ]; then\n      case \"$s\" in\n        *\" HOME OFFICE\") HOT=$s; HOX=$x; HOY=$y\n          case \"$s\" in SORTIE*) STATUS=IN ;; ENTR*) STATUS=OUT ;; esac ;;\n        \"SUR SITE\") SSX=$x; SSY=$y ;;\n        HUB) HUX=$x; HUY=$y ;;\n        *\"Temps de pr\"*) p=${s%%[!0-9:]*}; case \"$p\" in *[0-9]:[0-9][0-9]) PRES=$(minuten \"$p\") ;; esac ;;\n      esac\n    elif [ \"$x\" -gt 720 ]; then\n      case \"$s\" in [0-2][0-9]:[0-5][0-9]) ZEITEN=\"$ZEITEN $s\" ;; esac\n    fi\n  done < \"$1\"\n  LETZTE=\"\"; BUCH=0; PAUSE=0; aus=\"\"\n  # Zeiten abwechselnd rein/raus; Luecken nach einem Ausstempeln 11:00-14:30 = Mittagspause\n  for s in $(for s in $ZEITEN; do echo $s; done | sort -u); do\n    LETZTE=$s; BUCH=$(( BUCH + 1 )); m=$(minuten $s)\n    if [ $(( BUCH % 2 )) = 0 ]; then aus=$m\n    elif [ -n \"$aus\" ]; then [ $aus -ge 660 ] && [ $aus -le 870 ] && PAUSE=$(( PAUSE + m - aus )); aus=\"\"; fi\n  done; }\nD=$(cat $B/aktuell.txt 2>/dev/null); [ -d \"$D\" ] || { D=$B/lauf; mkdir -p \"$D\"; }\nL=$D/log.txt; exec 2>>\"$L\"\nt() { [ $DEBUG = 1 ] && echo \"$(date +%T) $*\" >> \"$L\"; }\njetzt\ngrep -v 'ticket=' > \"$D/seite-nach.txt\" <<'ENDE_SEITE'\n{v=seite}\nENDE_SEITE\nelemente \"$D/seite-nach.txt\" > \"$D/elemente-nach.txt\"\nstand \"$D/elemente-nach.txt\"\nt \"Seite nachher: Status=$STATUS Praesenz=$PRES Letzte=$LETZTE Buchungen=$BUCH Pause=$PAUSE\"\nA_AKTION=keine; A_STATUS=\"?\"; A_TYP=\"\"; A_NAME=\"\"; A_TEXT=\"\"; A_KORR=\"\"\n[ -f \"$D/aktion.txt\" ] && . \"$D/aktion.txt\"\nZ_DATUM=\"\"; Z_ORT=\"\"; Z_NAME=\"\"; [ -f $B/zustand.txt ] && . $B/zustand.txt\n[ \"$Z_DATUM\" = \"$HEUTE\" ] || { Z_ORT=\"\"; Z_NAME=\"\"; }\nort \"{last_loc_lat}\" \"{last_loc_long}\"\nif [ -n \"$PRES\" ] && [ \"$STATUS\" != \"?\" ]; then\n  # Knopf merken, mit dem eingestempelt wurde (fuers Ausstempeln)\n  case \"$A_AKTION\" in\n    tipp) Z_ORT=$A_TYP; Z_NAME=$A_NAME ;;\n    manuell) Z_ORT=\"\"; Z_NAME=\"\" ;;\n    *) if [ -z \"$Z_ORT\" ] && [ \"$STATUS\" = IN ]; then wahl EIN; Z_ORT=$KTYP; Z_NAME=$KNAME; fi ;;\n  esac\n  { echo \"Z_DATUM=$HEUTE\"; echo \"Z_STATUS=$STATUS\"; echo \"Z_PRES=$PRES\"; echo \"Z_LESE=$EPOCH\"; echo \"Z_LETZTE=$LETZTE\"; echo \"Z_BUCH=$BUCH\"\n    echo \"Z_ORT=$Z_ORT\"; echo \"Z_NAME='$Z_NAME'\"; } > $B/zustand.txt\n  ZL=\"\"; [ -n \"$Z_ORT\" ] && ZL=\" - $(label \"$Z_ORT\" \"$Z_NAME\")\"\n  REST=$(( SOLL - PRES ))\n  if [ \"$STATUS\" = IN ]; then\n    PZU=0; [ $PAUSE = 0 ] && [ $NOW -lt 870 ] && PZU=45\n    if [ $REST -gt 0 ]; then INFO=\"heute $(hm $PRES) - noch $(hm $REST) -> fertig um $(hm $(( (NOW + REST + PZU) % 1440 )))\"\n      [ $PZU -gt 0 ] && INFO=\"$INFO (mit 45 min Pause)\"\n    else INFO=\"heute $(hm $PRES) - 8 h 25 schon voll\"; fi\n    KOPF=\"Eingestempelt${LETZTE:+ $LETZTE}$ZL\"\n  else\n    if [ $REST -gt 0 ]; then INFO=\"heute $(hm $PRES) - noch $(hm $REST) offen\"\n      L2=$(minuten \"${LETZTE:-0:00}\")\n      [ $L2 -ge 660 ] && [ $L2 -le 870 ] && INFO=\"$INFO\nPause 30 min bis $(hm $(( L2 + 30 ))), 45 min bis $(hm $(( L2 + 45 )))\"\n    else INFO=\"heute $(hm $PRES) - Feierabend\"; fi\n    KOPF=\"Ausgestempelt${LETZTE:+ $LETZTE}\"\n    [ \"$A_AKTION\" = tipp ] && KOPF=\"$KOPF - $(label \"$A_TYP\" \"$A_NAME\")\"\n  fi\n  if [ \"$A_AKTION\" = tipp ] && [ \"$STATUS\" = \"$A_STATUS\" ]; then\n    MELD=\"ACHTUNG: $A_TEXT getippt, aber der Stand hat sich nicht geaendert ($KOPF). Bitte pruefen!\"\n  elif [ \"$A_AKTION\" = manuell ] && [ \"$STATUS\" != \"$A_STATUS\" ]; then MELD=\"$KOPF (von Hand)\n$INFO\"\n  elif [ -n \"$A_TEXT\" ] && [ \"$A_AKTION\" != tipp ]; then MELD=\"$A_TEXT\n$KOPF - $INFO\"\n  else MELD=\"$KOPF\n$INFO\"; fi\nelse\n  MELD=\"Stempelseite nicht gelesen - bitte selbst pruefen\"\n  [ \"$A_AKTION\" = keine ] && [ -n \"$A_TEXT\" ] && MELD=$A_TEXT\nfi\n# Erinnerung passte nicht (Stand oder Ort): nichts getippt, gleich die richtige Frage\nif [ -n \"$A_KORR\" ] && [ \"$STATUS\" != \"?\" ]; then\n  if [ \"$STATUS\" = OUT ]; then KZ=EIN; wahl EIN; KM=\"Du bist ausgestempelt${LETZTE:+ seit $LETZTE} - einstempeln? → $LABEL\"\n  else KZ=AUS; wahl AUS; KM=\"Du bist eingestempelt${LETZTE:+ seit $LETZTE} - ausstempeln? → $LABEL\"; fi\n  { echo \"V_ZIEL=$KZ\"; echo \"V_ZEIT=$EPOCH\"; echo \"V_DATUM=$HEUTE\"; echo \"V_LABEL='$LABEL'\"; echo \"V_GRUND='Korrektur'\"; } > $B/vorschlag-letzter.txt\n  cp $B/vorschlag-letzter.txt $B/vorschlag.txt\n  MELD=\"$A_TEXT. Neue Frage kommt.\"\n  signal \"$KM\"\n  t \"Korrektur-Vorschlag: $KM\"\nfi\nt \"Meldung: $MELD\"\nnote \"$MELD\" \"Stempeln\" stempeln\nrm -f $B/lock.txt\n","timeoutSeconds":40,"useHelper":false,"useShizuku":true,"disableLogging":false,"m_SIGUID":7486830550090397214,"m_classType":"ShellScriptAction","m_comment":"Stand lesen (tippt nichts), Zustand fuer den Waechter, Meldung","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false,"m_classType":"LaunchHomeScreenAction","m_SIGUID":-8975332127968786135}],"m_category":"Uncategorized","m_completed":true,"m_constraintList":[],"m_description":"Stempeln Stand v3.3 (29.10.2026) - liest nur, TIPPT NICHTS.\nWANN: nachdem du am Badge, am PC oder direkt auf der Seite gestempelt hast. Dann wissen die Erinnerungen deinen Stand (sonst fragt der Waechter evtl. falsch).\nSO LAEUFT ES: oeffnet die Stempelseite, liest Stand und Arbeitszeit und meldet z. B. \"Eingestempelt 07:55 - SUR SITE (Le Brassus), fertig um 16:21\".\nDU MUSST: von Hand starten; entsperren, falls verlangt. Braucht Shizuku.","m_descriptionOpen":false,"m_enabled":true,"m_excludeLog":false,"m_headingColor":0,"m_isOrCondition":false,"m_name":"Stempeln Stand v3.3","m_triggerList":[{"disableLogging":false,"m_SIGUID":-7005314894633794649,"m_classType":"EmptyTrigger","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}]},"macroExportVersion":1}